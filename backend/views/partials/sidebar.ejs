

<header
  class="bg-sidebar-start  text-accent-soft flex justify-between items-center p-4 md:hidden shadow-md w-full h-15 shrink-0"
>
  <div class="flex items-center space-x-2">
   
     <div class="flex items-center space-x-3">
      <div class="rounded-admin border border-brand-light/20 bg-brand/30 p-2">
        <i class="fa-solid fa-bolt text-lg text-brand-light"></i>
      </div>

      <span class="font-admin text-lg font-bold tracking-wide text-white">
        AdminPanel
      </span>
    </div>
    
  </div>

  <button
    id="mobileMenuBtn"
    type="button"
    aria-label="Open navigation menu"
    aria-controls="sidebar"
    aria-expanded="false"
    class="text-white transition-colors duration-200 hover:text-brand-light focus:outline-none"
  >
    <i class="fa-solid fa-bars text-xl"></i>
  </button>
</header>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-50 w-64 bg-gradient-to-b from-sidebar-start/90 via-sidebar-middle to-sidebar-end/90 text-sidebar-text -translate-x-full md:translate-x-0 md:static md:h-screen transition-transform duration-300 ease-in-out flex flex-col shadow-admin-md shrink-0"
>
  <div
    class="flex h-16 shrink-0 items-center justify-between border-b border-sidebar-border bg-sidebar-end/30 px-6"
  >
    <div class="flex items-center space-x-3">
      <div class="rounded-admin border border-brand-light/20 bg-brand/30 p-2">
        <i class="fa-solid fa-bolt text-lg text-brand-light"></i>
      </div>

      <span class="font-admin text-lg font-bold tracking-wide text-white">
        AdminPanel
      </span>
    </div>

    <button
      id="closeSidebarBtn"
      type="button"
      aria-label="Close navigation menu"
      class="text-sidebar-muted transition-colors duration-200 hover:text-white focus:outline-none md:hidden"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>
  </div>

  <nav
    class="min-h-0 flex-1 overflow-y-auto px-4 py-6"
    aria-label="Admin navigation"
  >
    <a
      href="/admin/dashboard"
      class="mb-1.5 flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <i class="fa-solid fa-house w-5 text-center text-sm"></i>

      <span>Dashboard</span>
    </a>
    <a
      href="/admin/user"
      class="mb-1.5 flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <i class="fa-solid fa-user w-5 text-center text-sm"></i>

      <span>Manage User</span>
    </a>

    <a
      href="/admin/staff"
      class="mb-1.5 flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <i class="fa-solid fa-users w-5 text-center text-sm"></i>

      <span> Manage Staff</span>
    </a>
    <a
      href="/admin/category"
      class="mb-1.5 flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <i class="fa-solid fa-ticket w-5 text-center text-sm"></i>

      <span>Manage Category</span>
    </a>
    <a
      href="/admin/servicerequest"
      class="mb-1.5 flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <i class="fa-solid fa-clipboard-list w-5 text-center text-sm"></i>
      <span>Manage ServiceRequest</span>
    </a>
    <a
      href="/admin/servicerequest/notification"
      class="mb-1.5 flex items-center justify-between rounded-admin px-3 py-2.5 font-medium text-white shadow-md shadow-brand-dark/20 transition-all duration-200 hover:bg-sidebar-hover"
    >
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-bell w-5 text-center text-sm"></i>

        <span>Notification</span>
      </div>

      <span
        id="notificationUnreadCount"
        class="hidden min-w-5 h-5 items-center justify-center rounded-full bg-danger px-1.5 text-xs font-bold text-white"
      >
        0
      </span>
    </a>
  </nav>

  <div
    class="mt-auto shrink-0 border-t border-sidebar-border bg-sidebar-end/20 p-4"
  >
    <a
      href="/admin/logout"
      id="adminLogoutBtn"
      class="flex items-center space-x-3 rounded-admin px-3 py-2.5 font-medium text-sidebar-muted transition-all duration-200 hover:bg-danger/20 hover:text-danger"
    >
      <i
        class="fa-solid fa-arrow-right-from-bracket w-5 text-center text-sm"
      ></i>

      <span>Logout</span>
    </a>
  </div>
</aside>

<div
  id="sidebarOverlay"
  class="fixed inset-0 z-40 hidden bg-overlay backdrop-blur-sm md:hidden"
  aria-hidden="true"
></div>

<script>
  (() => {
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebarOverlay");
    const mobileMenuBtn = document.getElementById("mobileMenuBtn");
    const closeSidebarBtn = document.getElementById("closeSidebarBtn");

    if (!sidebar || !overlay || !mobileMenuBtn || !closeSidebarBtn) {
      return;
    }

    function openSidebar() {
      sidebar.classList.remove("-translate-x-full");
      overlay.classList.remove("hidden");

      mobileMenuBtn.setAttribute("aria-expanded", "true");

      // Lock page scrolling only on mobile
      if (window.innerWidth < 768) {
        document.body.classList.add("overflow-hidden");
      }
    }

    function closeSidebar() {
      sidebar.classList.add("-translate-x-full");
      overlay.classList.add("hidden");

      mobileMenuBtn.setAttribute("aria-expanded", "false");

      document.body.classList.remove("overflow-hidden");
    }

    // Open
    mobileMenuBtn.addEventListener("click", openSidebar);

    // Close button
    closeSidebarBtn.addEventListener("click", closeSidebar);

    // Close when clicking overlay
    overlay.addEventListener("click", closeSidebar);

    // Close when clicking navigation link on mobile
    sidebar.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          closeSidebar();
        }
      });
    });

    // Close with Escape key
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && window.innerWidth < 768) {
        closeSidebar();
      }
    });

    // Handle responsive resize
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        closeSidebar();
      }
    });
  })();
</script>
