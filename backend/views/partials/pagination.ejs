<%
  const paginationData = pagination || {};

  const currentPage = Number(paginationData.page) || 1;
  const pageLimit = Number(paginationData.limit) || 5;
  const totalPagesCount = Number(paginationData.totalPages) || 1;
  const totalItemsCount = Number(paginationData.totalItems) || 0;

  const currentQuery = { ...(query || {}) };

  const createPageUrl = (pageNumber) => {
    const params = new URLSearchParams();

    Object.entries(currentQuery).forEach(([key, value]) => {
      if (
        value !== undefined &&
        value !== null &&
        value !== "" &&
        key !== "page" &&
        key !== "limit"
      ) {
        params.set(key, value);
      }
    });

    params.set("page", pageNumber);
    params.set("limit", pageLimit);

    return `${baseUrl}?${params.toString()}`;
  };

  const startItem =
    totalItemsCount > 0
      ? (currentPage - 1) * pageLimit + 1
      : 0;

  const endItem =
    totalItemsCount > 0
      ? Math.min(currentPage * pageLimit, totalItemsCount)
      : 0;
%>

<nav class="flex items-center justify-center border-t border-accent bg-accent-soft px-6 py-4">


  <% if (totalPagesCount > 1) { %>

    <div class="flex items-center space-x-2">

      <% if (currentPage > 1) { %>

        <a
          href="<%= createPageUrl(currentPage - 1) %>"
          class="inline-flex items-center justify-center rounded-lg border-2 border-accent bg-card px-3 py-2 text-sm font-medium text-text transition hover:bg-page-background"
        >
          <i class="fa-solid fa-chevron-left"></i>
        </a>

      <% } else { %>

        <span
          class="inline-flex cursor-not-allowed items-center justify-center rounded-lg border border-border bg-gray-100 px-3 py-2 text-sm font-medium text-gray-400"
        >
          <i class="fa-solid fa-chevron-left "></i>
        </span>

      <% } %>

      <% for (let i = 1; i <= totalPagesCount; i++) { %>

        <a
          href="<%= createPageUrl(i) %>"
          class="
            inline-flex h-9 min-w-9 items-center justify-center rounded-lg border px-3 text-sm font-medium transition
            <%= i === currentPage
              ? 'border-brand bg-brand text-white'
              : 'border-border bg-card text-text hover:bg-page-background'
            %>
          "
        >
          <%= i %>
        </a>

      <% } %>


     
      <% if (currentPage < totalPagesCount) { %>

        <a
          href="<%= createPageUrl(currentPage + 1) %>"
          class="inline-flex items-center justify-center rounded-lg border-2 border-accent bg-card px-3 py-2 text-sm font-medium text-text transition hover:bg-page-background"
        >
         
          <i class="fa-solid fa-chevron-right"></i>
        </a>

      <% } else { %>

        <span
          class="inline-flex cursor-not-allowed items-center justify-center rounded-lg border border-border bg-gray-100 px-3 py-2 text-sm font-medium text-gray-400"
        >
         
          <i class="fa-solid fa-chevron-right"></i>
        </span>

      <% } %>

    </div>

  <% } %>

  </nav>