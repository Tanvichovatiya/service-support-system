<%
const availableSkills = [
"Technical Support",
"Networking",
"Hardware",
"Software",
"Database",
"System Administration",
"IT Support",
"Customer Support"
];

const selectedSkills = Array.isArray(selectedSkillsData)
? selectedSkillsData
: [];
%>

<div class="border-b border-border p-5 sm:p-8">

  <div class="mb-6">


<div class="mb-2 flex items-center gap-3">

  <div
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-admin bg-brand-soft text-brand"
  >
    <i class="fa-solid fa-screwdriver-wrench"></i>
  </div>

  <h2 class="text-lg font-bold text-heading">
    Skills
  </h2>

</div>

<p class="text-sm leading-6 text-text-secondary">
  Select skills that can help with service request assignment.
</p>


  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">


<% availableSkills.forEach((skill) => { %>

  <label
    class="skill-card group flex cursor-pointer items-center gap-3 p-3"
  >

    <input
      type="checkbox"
      name="skills"
      value="<%= skill %>"
      <%= selectedSkills.includes(skill) ? "checked" : "" %>
      class="skill-checkbox h-4 w-4 cursor-pointer rounded border-input-border accent-brand"
    >

    <span
      class="skill-label text-sm font-medium text-text-secondary"
    >
      <%= skill %>
    </span>

  </label>

<% }) %>


  </div>

<% if (typeof errors !== "undefined" && errors?.skills) { %>


<p class="mt-3 text-sm font-medium text-danger">
  <%= errors.skills.msg %>
</p>


<% } %>

  <p
    id="skillsError"
    class="mt-3 hidden text-sm font-medium text-danger"
  >
    Please select at least one skill.
  </p>

</div>
