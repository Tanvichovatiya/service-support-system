<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= serviceRequest?.title || "Service Request" %>
    </title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <%- include("../../partials/toast") %>

</head>

<body class="bg-page-background font-admin text-text antialiased">

    <div class="flex h-screen flex-col md:flex-row">

        <%- include("../../partials/sidebar") %>

        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">

            <header class="shrink-0 border-b border-border bg-background">

                <div
                    class="flex flex-col gap-4 px-6 py-5 lg:flex-row lg:items-center lg:justify-between"
                >

                    <div class="min-w-0">

                        <div class="mb-3">

                            <a
                                href="/admin/servicerequest"
                                class="inline-flex h-9 w-9 items-center justify-center rounded-admin border border-border bg-card text-sm text-text-secondary transition hover:bg-surface-soft hover:text-text-primary"
                                title="Back to Requests"
                            >
                                <i class="fa-solid fa-arrow-left"></i>
                            </a>

                        </div>

                        <p class="text-sm font-medium text-brand">
                            Service Management
                        </p>

                        <div class="mt-1 flex flex-wrap items-center gap-2">

                            <h1 class="text-2xl font-bold text-accent">
                                Service Request
                            </h1>

                            <span class="text-text-muted">
                                /
                            </span>

                            <span
                                class="max-w-[400px] truncate text-sm text-text-secondary"
                                title="<%= serviceRequest?.title || '' %>"
                            >
                                <%= serviceRequest?.title || "Request Details" %>
                            </span>

                        </div>

                        <p class="mt-1 text-sm text-text-muted">
                            View complete request information, comments and activity history
                        </p>

                    </div>

                    <% if (serviceRequest) { %>

                        <div class="flex flex-wrap items-center gap-2">

                            <% if (serviceRequest.status === "pending") { %>

                                <button
                                    type="button"
                                    class="assign-staff-btn inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-admin bg-brand px-4 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                    data-id="<%= serviceRequest._id %>"
                                >
                                    <i class="fa-solid fa-user-plus"></i>
                                    Assign Staff
                                </button>

                            <% } %>

                            <% if (
                                serviceRequest.status === "assigned" ||
                                serviceRequest.status === "in_progress"
                            ) { %>

                                <button
                                    type="button"
                                    class="reassign-staff-btn inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-admin border border-brand bg-brand/10 px-4 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white"
                                    data-id="<%= serviceRequest._id %>"
                                >
                                    <i class="fa-solid fa-users-gear"></i>
                                    Reassign
                                </button>

                            <% } %>

                            <% if (
                                serviceRequest.status === "pending" ||
                                serviceRequest.status === "assigned" ||
                                serviceRequest.status === "in_progress"
                            ) { %>

                                <button
                                    type="button"
                                    class="update-status-btn inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-admin border border-border bg-card px-4 text-sm font-semibold text-text-secondary transition hover:bg-surface-soft hover:text-text-primary"
                                    data-id="<%= serviceRequest._id %>"
                                    data-status="<%= serviceRequest.status %>"
                                >
                                    <i class="fa-solid fa-arrows-rotate"></i>
                                    Update Status
                                </button>

                            <% } %>

                        </div>

                    <% } %>

                </div>

            </header>

            <section class="flex-1 overflow-y-auto px-4 py-6 sm:px-6 sm:py-8">

                <% if (!serviceRequest) { %>

                    <div class="mx-auto max-w-3xl">

                        <div
                            class="rounded-admin-xl border border-border bg-card px-6 py-16 text-center shadow-admin"
                        >

                            <div
                                class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-danger-light text-danger"
                            >
                                <i class="fa-solid fa-circle-exclamation text-xl"></i>
                            </div>

                            <h2 class="mt-4 text-lg font-bold text-text-primary">
                                Service request not found
                            </h2>

                            <p class="mt-1 text-sm text-text-muted">
                                The requested service request could not be found.
                            </p>

                            <a
                                href="/admin/servicerequest"
                                class="mt-6 inline-flex items-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                            >
                                <i class="fa-solid fa-arrow-left"></i>
                                Back to Requests
                            </a>

                        </div>

                    </div>

                <% } else { %>

                    <div class="mx-auto max-w-10xl space-y-5">

                        <div
                            class="overflow-hidden rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                        >

                            <div class="border-b border-border bg-card px-5 py-5 sm:px-6">

                                <div
                                    class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between"
                                >

                                    <div class="flex min-w-0 items-start gap-4">

                                        <div
                                            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"
                                        >
                                            <i class="fa-solid fa-ticket text-lg"></i>
                                        </div>

                                        <div class="min-w-0">

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Service Request
                                            </p>

                                            <h2
                                                class="mt-1 break-words text-xl font-bold text-text-primary"
                                            >
                                                <%= serviceRequest.title || "-" %>
                                            </h2>

                                            <p class="mt-2 text-xs text-text-muted">

                                                <i class="fa-regular fa-calendar mr-1"></i>

                                                Created

                                                <%= serviceRequest.createdAt
                                                    ? new Date(serviceRequest.createdAt).toLocaleString(
                                                        "en-IN",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric",
                                                            hour: "2-digit",
                                                            minute: "2-digit"
                                                        }
                                                    )
                                                    : "-"
                                                %>

                                            </p>

                                        </div>

                                    </div>

                                    <div class="shrink-0">

                                        <% if (serviceRequest.status === "pending") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                            >
                                                <i class="fa-solid fa-clock"></i>
                                                Pending
                                            </span>

                                        <% } else if (serviceRequest.status === "assigned") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-info-light px-3 py-1.5 text-xs font-semibold text-info-dark"
                                            >
                                                <i class="fa-solid fa-user-check"></i>
                                                Assigned
                                            </span>

                                        <% } else if (serviceRequest.status === "in_progress") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand"
                                            >
                                                <i class="fa-solid fa-spinner"></i>
                                                In Progress
                                            </span>

                                        <% } else if (serviceRequest.status === "completed") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-success-light px-3 py-1.5 text-xs font-semibold text-success-dark"
                                            >
                                                <i class="fa-solid fa-circle-check"></i>
                                                Completed
                                            </span>

                                        <% } else if (serviceRequest.status === "cancelled") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger-dark"
                                            >
                                                <i class="fa-solid fa-ban"></i>
                                                Cancelled
                                            </span>

                                        <% } else { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-page-background px-3 py-1.5 text-xs font-semibold capitalize text-text-secondary"
                                            >
                                                <%= serviceRequest.status || "-" %>
                                            </span>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                            <div
                                class="grid grid-cols-1 gap-4 p-5 sm:p-6 md:grid-cols-2 xl:grid-cols-3"
                            >

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-1.5">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Requested By :
                                            </p>

                                            <p
                                                class="truncate font-semibold text-text-primary"
                                                title="<%= serviceRequest.user
                                                    ? `${serviceRequest.user.firstname || ""} ${serviceRequest.user.lastname || ""}`.trim()
                                                    : "Unknown User"
                                                %>"
                                            >
                                                <%= serviceRequest.user
                                                    ? `${serviceRequest.user.firstname || ""} ${serviceRequest.user.lastname || ""}`.trim()
                                                    : "Unknown User"
                                                %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-layer-group"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-1.5">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Category :
                                            </p>

                                            <p
                                                class="truncate font-semibold text-text-primary"
                                                title="<%= serviceRequest.category?.name || '-' %>"
                                            >
                                                <%= serviceRequest.category?.name || "-" %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-flag"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-2">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Priority :
                                            </p>

                                            <% if (serviceRequest.priority === "urgent") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger-dark"
                                                >
                                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                                    Urgent
                                                </span>

                                            <% } else if (serviceRequest.priority === "high") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                                >
                                                    <i class="fa-solid fa-arrow-up"></i>
                                                    High
                                                </span>

                                            <% } else if (serviceRequest.priority === "medium") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand"
                                                >
                                                    <i class="fa-solid fa-minus"></i>
                                                    Medium
                                                </span>

                                            <% } else { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-page-background px-3 py-1.5 text-xs font-semibold text-text-secondary"
                                                >
                                                    <i class="fa-solid fa-arrow-down"></i>
                                                    Low
                                                </span>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-regular fa-calendar-plus"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-1.5">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Created At :
                                            </p>

                                            <p class="truncate text-sm font-semibold text-text-primary">
                                                <%= serviceRequest.createdAt
                                                    ? new Date(serviceRequest.createdAt).toLocaleString(
                                                        "en-IN",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric",
                                                            hour: "2-digit",
                                                            minute: "2-digit"
                                                        }
                                                    )
                                                    : "-"
                                                %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-regular fa-clock"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-1.5">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Last Updated :
                                            </p>

                                            <p class="truncate text-sm font-semibold text-text-primary">
                                                <%= serviceRequest.updatedAt
                                                    ? new Date(serviceRequest.updatedAt).toLocaleString(
                                                        "en-IN",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric",
                                                            hour: "2-digit",
                                                            minute: "2-digit"
                                                        }
                                                    )
                                                    : "-"
                                                %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="rounded-xl border border-border bg-surface px-4 py-4">

                                    <div class="flex items-center gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-chart-simple"></i>
                                        </div>

                                        <div class="flex min-w-0 items-center gap-2">

                                            <p class="shrink-0 text-xs font-semibold tracking-wide text-text-muted">
                                                Current Status :
                                            </p>

                                            <% if (serviceRequest.status === "pending") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                                >
                                                    <i class="fa-solid fa-clock"></i>
                                                    Pending
                                                </span>

                                            <% } else if (serviceRequest.status === "assigned") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-info-light px-3 py-1.5 text-xs font-semibold text-info-dark"
                                                >
                                                    <i class="fa-solid fa-user-check"></i>
                                                    Assigned
                                                </span>

                                            <% } else if (serviceRequest.status === "in_progress") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand"
                                                >
                                                    <i class="fa-solid fa-spinner"></i>
                                                    In Progress
                                                </span>

                                            <% } else if (serviceRequest.status === "completed") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-success-light px-3 py-1.5 text-xs font-semibold text-success-dark"
                                                >
                                                    <i class="fa-solid fa-circle-check"></i>
                                                    Completed
                                                </span>

                                            <% } else if (serviceRequest.status === "cancelled") { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger-dark"
                                                >
                                                    <i class="fa-solid fa-ban"></i>
                                                    Cancelled
                                                </span>

                                            <% } else { %>

                                                <span
                                                    class="inline-flex items-center gap-1.5 rounded-full bg-page-background px-3 py-1.5 text-xs font-semibold text-text-secondary"
                                                >
                                                    <%= serviceRequest.status || "-" %>
                                                </span>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div
                            class="rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                        >

                            <div class="border-b border-border px-5 py-4 sm:px-6">

                                <div class="flex items-center gap-2">

                                    <i class="fa-solid fa-users text-accent"></i>

                                    <h3 class="text-sm font-bold text-text-primary">
                                        Assigned Staff
                                    </h3>

                                    <span
                                        class="rounded-full bg-info-light px-2.5 py-1 text-xs font-semibold text-info-dark"
                                    >
                                        <%= serviceRequest.assignedStaff?.length || 0 %>
                                    </span>

                                </div>

                            </div>

                            <div class="px-5 py-4 sm:px-6">

                                <% if (serviceRequest.assignedStaff?.length) { %>

                                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">

                                        <% serviceRequest.assignedStaff.forEach((staff) => { %>

                                            <div
                                                class="flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3"
                                            >

                                                <% if (staff.user?.profilePic) { %>

                                                    <img
                                                        src="<%= staff.user.profilePic %>"
                                                        alt="<%= `${staff.user?.firstname || ''} ${staff.user?.lastname || ''}`.trim() || 'Staff' %>"
                                                        class="h-10 w-10 shrink-0 rounded-full object-cover"
                                                    >

                                                <% } else { %>

                                                    <div
                                                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-info-light text-sm font-semibold text-info"
                                                    >
                                                        <%= staff.user?.firstname
                                                            ? staff.user.firstname.charAt(0).toUpperCase()
                                                            : "S"
                                                        %>
                                                    </div>

                                                <% } %>

                                                <div class="min-w-0">

                                                    <p class="truncate font-semibold text-text-primary">
                                                        <%= `${staff.user?.firstname || ''} ${staff.user?.lastname || ''}`.trim() || "Unknown Staff" %>
                                                    </p>

                                                    <p class="truncate text-xs text-text-muted">
                                                        <%= staff.employeeId || "-" %>
                                                    </p>

                                                </div>

                                            </div>

                                        <% }) %>

                                    </div>

                                <% } else { %>

                                    <div
                                        class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                    >

                                        <div
                                            class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                        >
                                            <i class="fa-solid fa-user-slash"></i>
                                        </div>

                                        <p class="mt-3 text-sm font-semibold text-text-primary">
                                            No staff assigned
                                        </p>

                                        <p class="mt-1 text-xs text-text-muted">
                                            No staff members have been assigned to this request.
                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                        <div
                            class="rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                        >

                            <div class="border-b border-border px-5 py-4 sm:px-6">

                                <div class="flex items-center gap-2">

                                    <i class="fa-solid fa-user-check text-accent"></i>

                                    <h3 class="text-sm font-bold text-text-primary">
                                        Accepted Staff
                                    </h3>

                                    <span
                                        class="rounded-full bg-success-light px-2.5 py-1 text-xs font-semibold text-success-dark"
                                    >
                                        <%= serviceRequest.acceptedStaff?.length || 0 %>
                                    </span>

                                </div>

                            </div>

                            <div class="px-5 py-4 sm:px-6">

                                <% if (serviceRequest.acceptedStaff?.length) { %>

                                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">

                                        <% serviceRequest.acceptedStaff.forEach((staff) => { %>

                                            <div
                                                class="flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3"
                                            >

                                                <% if (staff.user?.profilePic) { %>

                                                    <img
                                                        src="<%= staff.user.profilePic %>"
                                                        alt="<%= `${staff.user?.firstname || ''} ${staff.user?.lastname || ''}`.trim() || 'Staff' %>"
                                                        class="h-10 w-10 shrink-0 rounded-full object-cover"
                                                    >

                                                <% } else { %>

                                                    <div
                                                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-success-light text-sm font-semibold text-success-dark"
                                                    >
                                                        <%= staff.user?.firstname
                                                            ? staff.user.firstname.charAt(0).toUpperCase()
                                                            : "S"
                                                        %>
                                                    </div>

                                                <% } %>

                                                <div class="min-w-0">

                                                    <p class="truncate font-semibold text-text-primary">
                                                        <%= `${staff.user?.firstname || ''} ${staff.user?.lastname || ''}`.trim() || "Unknown Staff" %>
                                                    </p>

                                                    <p class="truncate text-xs text-text-muted">
                                                        <%= staff.employeeId || "-" %>
                                                    </p>

                                                </div>

                                            </div>

                                        <% }) %>

                                    </div>

                                <% } else { %>

                                    <div
                                        class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                    >

                                        <div
                                            class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                        >
                                            <i class="fa-solid fa-clock"></i>
                                        </div>

                                        <p class="mt-3 text-sm font-semibold text-text-primary">
                                            No staff accepted
                                        </p>

                                        <p class="mt-1 text-xs text-text-muted">
                                            No assigned staff member has accepted this request yet.
                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">

                            <div class="space-y-5 lg:col-span-5">

                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                                >

                                    <div class="border-b border-border px-5 py-4 sm:px-6">

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-align-left text-accent"></i>

                                            <h3 class="text-sm font-bold text-text-primary">
                                                Description
                                            </h3>

                                        </div>

                                    </div>

                                    <div class="px-5 py-5 sm:px-6">

                                        <div
                                            class="rounded-xl border border-border bg-surface-soft px-4 py-3"
                                        >

                                            <p class="text-left text-sm leading-7 text-brand">
                                                <%= serviceRequest.description || "No description provided." %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                                >

                                    <div class="border-b border-border px-5 py-4 sm:px-6">

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-paperclip text-accent"></i>

                                            <h3 class="text-sm font-bold text-text-primary">
                                                Attachments
                                            </h3>

                                            <span
                                                class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent"
                                            >
                                                <%= serviceRequest.attachments?.length || 0 %>
                                            </span>

                                        </div>

                                    </div>

                                    <div class="px-5 py-3 sm:px-6">

                                        <% if (serviceRequest.attachments?.length) { %>

                                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">

                                                <% serviceRequest.attachments.forEach((attachment) => { %>

                                                    <div
                                                        class="group flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3 transition hover:border-accent-light hover:bg-accent-soft/10"
                                                    >

                                                        <div
                                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent"
                                                        >
                                                            <i class="fa-solid fa-file"></i>
                                                        </div>

                                                        <div class="min-w-0 flex-1">

                                                            <p
                                                                class="truncate text-sm font-semibold text-text-primary"
                                                                title="<%= attachment.originalName %>"
                                                            >
                                                                <%= attachment.originalName %>
                                                            </p>

                                                            <p class="mt-0.5 text-xs text-text-muted">
                                                                <%= attachment.mimeType %>
                                                            </p>

                                                        </div>

                                                        <a
                                                            href="/attachment/download/<%= attachment._id %>"
                                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-text-muted transition hover:bg-accent-soft hover:text-accent"
                                                            title="Download attachment"
                                                            aria-label="Download <%= attachment.originalName %>"
                                                        >
                                                            <i class="fa-solid fa-download"></i>
                                                        </a>

                                                    </div>

                                                <% }) %>

                                            </div>

                                        <% } else { %>

                                            <div
                                                class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                            >

                                                <div
                                                    class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                                >
                                                    <i class="fa-solid fa-paperclip"></i>
                                                </div>

                                                <p class="mt-3 text-sm font-semibold text-text-primary">
                                                    No attachments
                                                </p>

                                                <p class="mt-1 text-xs text-text-muted">
                                                    No files were attached to this request.
                                                </p>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                            <div class="space-y-5 lg:col-span-7">

                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card hover:shadow-admin-hover"
                                >

                                    <div class="border-b border-border px-5 py-4">

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-clock-rotate-left text-accent"></i>

                                            <h3 class="text-sm font-bold text-text-primary">
                                                Activity History
                                            </h3>

                                        </div>

                                    </div>

                                    <div class="space-y-3 px-5 py-5">

                                        <% if (serviceRequest.history?.length) { %>

                                            <% serviceRequest.history.forEach((item) => { %>

                                                <%
                                                    const actor = item.actor;

                                                    const actorName = actor
                                                        ? `${actor.firstname || ""} ${actor.lastname || ""}`.trim()
                                                        : "System";

                                                    const actorInitial = actor?.firstname
                                                        ? actor.firstname.charAt(0).toUpperCase()
                                                        : "S";

                                                    const actionMap = {
                                                        SERVICE_REQUEST_CREATED: "Service Request created",
                                                        SERVICE_REQUEST_ASSIGNED: "Service Request assigned",
                                                        SERVICE_REQUEST_REASSIGNED: "Service Request reassigned",
                                                        STATUS_CHANGED: "Status changed",
                                                        REQUEST_CANCELLED: "Request cancelled",
                                                        REQUEST_COMPLETED: "Request completed",
                                                        FILE_UPLOADED: "File uploaded",
                                                        COMMENT_ADDED: "Comment added"
                                                    };

                                                    const rawAction =
                                                        item.action ||
                                                        item.activity ||
                                                        item.description ||
                                                        "Service request updated";

                                                    const action =
                                                        actionMap[rawAction] ||
                                                        rawAction
                                                            .toLowerCase()
                                                            .replace(/_/g, " ")
                                                            .replace(/\b\w/g, (char) => char.toUpperCase());
                                                %>

                                                <div
                                                    class="rounded-xl border border-border bg-surface-soft px-4 py-4"
                                                >

                                                    <div class="flex items-start gap-3">

                                                        <div
                                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent"
                                                        >
                                                            <%= actorInitial %>
                                                        </div>

                                                        <div class="min-w-0 flex-1">

                                                            <div class="flex flex-col gap-1">

                                                                <p class="text-sm font-semibold text-text-primary">
                                                                    <%= action %>
                                                                </p>

                                                                <p class="text-xs text-text-muted">

                                                                    <%= item.createdAt
                                                                        ? new Date(item.createdAt).toLocaleString(
                                                                            "en-IN",
                                                                            {
                                                                                day: "2-digit",
                                                                                month: "short",
                                                                                year: "numeric",
                                                                                hour: "2-digit",
                                                                                minute: "2-digit"
                                                                            }
                                                                        )
                                                                        : "-"
                                                                    %>

                                                                </p>

                                                            </div>

                                                            <p class="mt-1 text-xs text-text-secondary">

                                                                By

                                                                <span class="font-semibold text-text-primary">
                                                                    <%= actorName %>
                                                                </span>

                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>

                                            <% }) %>

                                        <% } else { %>

                                            <div
                                                class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                            >

                                                <div
                                                    class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                                >
                                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                                </div>

                                                <p class="mt-3 text-sm font-semibold text-text-primary">
                                                    No activity history
                                                </p>

                                                <p class="mt-1 text-xs text-text-muted">
                                                    No activity has been recorded yet.
                                                </p>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                <% } %>

            </section>

        </main>

    </div>

    <%- include("assignStaff") %>
    <%- include("updateReqStatus") %>
    <%- include("reassignStaff") %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/adminSocket.js"></script>

    <script src="/js/serviceReq.js"></script>
    <script src="/js/updateReqStatus.js"></script>
    <script src="/js/reassign.js"></script>

    <script src="/js/adminNotification.js"></script>
    <script src="/js/adminNotificationPage.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            AdminNotification.getUnreadCount();
        });
    </script>

</body>

</html>