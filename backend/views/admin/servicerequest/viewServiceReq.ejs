
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= serviceRequest?.title || "Service Request" %>
    </title>

    <link
        rel="stylesheet"
        href="/css/output.css"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
        integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >

    <%- include('../../partials/toast') %>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/adminSocket.js"></script>
</head>


<body class="bg-page-background font-admin text-text antialiased">

    <div class="flex h-screen flex-col md:flex-row">

        <%- include('../../partials/sidebar') %>


        <main class="flex min-w-0 flex-1 flex-col overflow-hidden">

           

            <header class="shrink-0 border-b border-border bg-background">

                <div
                    class="flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between"
                >

                    <div class="min-w-0">

                        <p class="text-sm font-medium text-brand">
                            Service Management
                        </p>

                        <div class="mt-1 flex flex-wrap items-center gap-2">

                            <h1 class="text-2xl font-bold text-accent">
                                Service Request
                            </h1>

                            <span class="text-text-muted">
                                /
                            </span>

                            <span
                                class="max-w-[400px] truncate text-sm text-text-secondary"
                                title="<%= serviceRequest?.title || '' %>"
                            >
                                <%= serviceRequest?.title || "Request Details" %>
                            </span>

                        </div>

                        <p class="mt-1 text-sm text-text-muted">
                            View complete request information, comments and activity history
                        </p>

                    </div>



                    <a
                        href="/admin/servicerequest"
                        class="inline-flex h-10 items-center justify-center gap-2 rounded-admin border border-border bg-brand  px-4 text-sm font-semibold text-accent-soft shadow-admin transition hover:shadow-admin-hover"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Requests
                    </a>

                </div>

            </header>


            <section class="flex-1 overflow-y-auto px-4 py-6 sm:px-6 sm:py-8">

                <% if (!serviceRequest) { %>


                    <div class="mx-auto max-w-3xl">

                        <div
                            class="rounded-admin-xl border border-border bg-card px-6 py-16 text-center shadow-admin"
                        >

                            <div
                                class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-danger-light text-danger"
                            >
                                <i class="fa-solid fa-circle-exclamation text-xl"></i>
                            </div>

                            <h2
                                class="mt-4 text-lg font-bold text-text-primary"
                            >
                                Service request not found
                            </h2>

                            <p
                                class="mt-1 text-sm text-text-muted"
                            >
                                The requested service request could not be found.
                            </p>

                            <a
                                href="/admin/servicerequest"
                                class="mt-6 inline-flex items-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                            >
                                <i class="fa-solid fa-arrow-left"></i>
                                Back to Requests
                            </a>

                        </div>

                    </div>


                <% } else { %>


                    <div class="mx-auto max-w-7xl space-y-5">



                        <div
                            class="overflow-hidden rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin">

                            <div
                                class="border-b border-border bg-card px-5 py-5 sm:px-6" >

                                <div
                                    class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between"
                                >

                                    <div class="flex min-w-0 items-start gap-4">

                                        <div
                                            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"
                                        >
                                            <i class="fa-solid fa-ticket text-lg"></i>
                                        </div>

                                        <div class="min-w-0">

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Service Request
                                            </p>

                                            <h2
                                                class="mt-1 break-words text-xl font-bold text-text-primary"
                                            >
                                                <%= serviceRequest.title || "-" %>
                                            </h2>

                                            <p class="mt-2 text-xs text-text-muted">

                                                <i class="fa-regular fa-calendar mr-1"></i>

                                                Created
                                                <%= serviceRequest.createdAt
                                                    ? new Date(serviceRequest.createdAt).toLocaleString("en-IN", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric",
                                                        hour: "2-digit",
                                                        minute: "2-digit"
                                                    })
                                                    : "-"
                                                %>

                                            </p>

                                        </div>

                                    </div>


                                    <!-- Status -->

                                    <div class="shrink-0">

                                        <% if (serviceRequest.status === "pending") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                            >
                                                <i class="fa-solid fa-clock"></i>
                                                Pending
                                            </span>

                                        <% } else if (serviceRequest.status === "assigned") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-info-light px-3 py-1.5 text-xs font-semibold text-info-dark"
                                            >
                                                <i class="fa-solid fa-user-check"></i>
                                                Assigned
                                            </span>

                                        <% } else if (serviceRequest.status === "in_progress") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand"
                                            >
                                                <i class="fa-solid fa-spinner"></i>
                                                In Progress
                                            </span>

                                        <% } else if (serviceRequest.status === "completed") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-success-light text-success-dark px-3 py-1.5 text-xs font-semibold"
                                            >
                                                <i class="fa-solid fa-circle-check"></i>
                                                Completed
                                            </span>

                                        <% } else { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-page-background px-3 py-1.5 text-xs font-semibold text-text-secondary"
                                            >
                                                <%= serviceRequest.status || "-" %>
                                            </span>

                                        <% } %>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================================
                                 BASIC INFORMATION
                            ================================================== -->

                            <div class="grid grid-cols-1 gap-4 p-5 sm:p-6 lg:grid-cols-4">


                                <!-- User -->

                                <div
                                    class="rounded-xl border border-border bg-surface px-4 py-4"
                                >

                                    <div class="flex items-start gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <div class="min-w-0">

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Requested By
                                            </p>

                                            <p
                                                class="mt-1 truncate font-semibold text-text-primary"
                                            >
                                                <%= serviceRequest.user
                                                    ? `${serviceRequest.user.firstname || ""} ${serviceRequest.user.lastname || ""}`.trim()
                                                    : "Unknown User"
                                                %>
                                            </p>

                                            <p
                                                class="truncate text-xs text-text-muted"
                                                title="<%= serviceRequest.user?.email || '' %>"
                                            >
                                                <%= serviceRequest.user?.email || "-" %>
                                            </p>

                                        </div>

                                    </div>

                                </div>


                                <!-- Category -->

                                <div
                                    class="rounded-xl border border-border bg-surface px-4 py-4"
                                >

                                    <div class="flex items-start gap-3">

                                        <div
                                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                                        >
                                            <i class="fa-solid fa-layer-group"></i>
                                        </div>

                                        <div class="min-w-0">

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Category
                                            </p>

                                            <p
                                                class="mt-1 truncate font-semibold text-text-primary"
                                            >
                                                <%= serviceRequest.category?.name || "-" %>
                                            </p>

                                            <% if (serviceRequest.category) { %>

                                                <% if (serviceRequest.category.isActive) { %>

                                                    <span class="text-xs text-success-dark">
                                                        Active
                                                    </span>

                                                <% } else { %>

                                                    <span class="text-xs text-danger-dark">
                                                        Inactive
                                                    </span>

                                                <% } %>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>


                                <!-- Priority -->

                                <div
                                    class="rounded-xl border border-border bg-surface px-4 py-4"
                                >

                                    <p
                                        class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                    >
                                        Priority
                                    </p>

                                    <div class="mt-2">

                                        <% if (serviceRequest.priority === "urgent") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger-dark"
                                            >
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                                Urgent
                                            </span>

                                        <% } else if (serviceRequest.priority === "high") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                            >
                                                <i class="fa-solid fa-arrow-up"></i>
                                                High
                                            </span>

                                        <% } else if (serviceRequest.priority === "medium") { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand"
                                            >
                                                <i class="fa-solid fa-minus"></i>
                                                Medium
                                            </span>

                                        <% } else { %>

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-page-background px-3 py-1.5 text-xs font-semibold text-text-secondary"
                                            >
                                                <i class="fa-solid fa-arrow-down"></i>
                                                Low
                                            </span>

                                        <% } %>

                                    </div>

                                </div>


                                <!-- Assigned Staff -->

                                <div
                                    class="rounded-xl border border-border bg-surface px-4 py-4"
                                >

                                    <p
                                        class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                    >
                                        Assigned Staff
                                    </p>

                                    <% if (serviceRequest.assignedStaff) { %>

                                        <div class="mt-2 flex items-center gap-3">

                                            <div
                                                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-info-light text-sm font-semibold text-info"
                                            >
                                                <%= serviceRequest.assignedStaff.user?.firstname
                                                    ? serviceRequest.assignedStaff.user.firstname.charAt(0).toUpperCase()
                                                    : "S"
                                                %>
                                            </div>

                                            <div class="min-w-0">

                                                <p
                                                    class="truncate font-semibold text-text-primary"
                                                >
                                                    <%= `${serviceRequest.assignedStaff.user?.firstname || ""} ${serviceRequest.assignedStaff.user?.lastname || ""}`.trim() || "Unknown Staff" %>
                                                </p>

                                                <p
                                                    class="truncate text-xs text-text-muted"
                                                >
                                                    <%= serviceRequest.assignedStaff.employeeId || "-" %>
                                                </p>

                                                <p
                                                    class="truncate text-xs text-text-muted"
                                                >
                                                    <%= serviceRequest.assignedStaff.user?.email || "-" %>
                                                </p>

                                            </div>

                                        </div>

                                    <% } else { %>

                                        <div class="mt-2">

                                            <span
                                                class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark"
                                            >
                                                <i class="fa-solid fa-user-slash"></i>
                                                Not Assigned
                                            </span>

                                        </div>

                                    <% } %>

                                </div>

                            </div>

                        </div>



                        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">


                            <div class="space-y-5 lg:col-span-2">


                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin"
                                >

                                    <div
                                        class="border-b border-border px-5 py-4 sm:px-6"
                                    >

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-align-left text-accent"></i>

                                            <h3
                                                class="text-sm font-bold text-text-primary"
                                            >
                                                Description
                                            </h3>

                                        </div>

                                    </div>

                                    <div class="px-5 py-5 sm:px-6">

                                        <div
                                            class="rounded-xl border border-border bg-surface-soft px-4 py-4"
                                        >

                                            <p
                                                class="whitespace-pre-wrap text-sm leading-7 text-text-secondary"
                                            >
                                                <%= serviceRequest.description || "No description provided." %>
                                            </p>

                                        </div>

                                    </div>

                                </div>


                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin"
                                >

                                    <div
                                        class="border-b border-border px-5 py-4 sm:px-6"
                                    >

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-paperclip text-accent"></i>

                                            <h3
                                                class="text-sm font-bold text-text-primary"
                                            >
                                                Attachments
                                            </h3>

                                            <span
                                                class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent"
                                            >
                                                <%= serviceRequest.attachments?.length || 0 %>
                                            </span>

                                        </div>

                                    </div>


                                    <div class="px-5 py-5 sm:px-6">

                                        <% if (serviceRequest.attachments?.length) { %>

                                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">

                                                <% serviceRequest.attachments.forEach((attachment, index) => { %>

                                                    <%
                                                        const attachmentUrl =
                                                            typeof attachment === "string"
                                                                ? attachment
                                                                : attachment?.url ||
                                                                  attachment?.secure_url ||
                                                                  attachment?.path ||
                                                                  "";

                                                        const attachmentName =
                                                            typeof attachment === "string"
                                                                ? `Attachment ${index + 1}`
                                                                : attachment?.name ||
                                                                  attachment?.originalname ||
                                                                  `Attachment ${index + 1}`;
                                                    %>

                                                    <% if (attachmentUrl) { %>

                                                        <a
                                                            href="<%= attachmentUrl %>"
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="group flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3 transition hover:border-accent-light hover:bg-accent-soft/10"
                                                        >

                                                            <div
                                                                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent"
                                                            >
                                                                <i class="fa-solid fa-file"></i>
                                                            </div>

                                                            <div class="min-w-0 flex-1">

                                                                <p
                                                                    class="truncate text-sm font-semibold text-text-primary"
                                                                    title="<%= attachmentName %>"
                                                                >
                                                                    <%= attachmentName %>
                                                                </p>

                                                                <p class="text-xs text-text-muted">
                                                                    Open attachment
                                                                </p>

                                                            </div>

                                                            <i
                                                                class="fa-solid fa-arrow-up-right-from-square text-xs text-text-muted transition group-hover:text-accent"
                                                            ></i>

                                                        </a>

                                                    <% } %>

                                                <% }); %>

                                            </div>

                                        <% } else { %>

                                            <div
                                                class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                            >

                                                <div
                                                    class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                                >
                                                    <i class="fa-solid fa-paperclip"></i>
                                                </div>

                                                <p
                                                    class="mt-3 text-sm font-semibold text-text-primary"
                                                >
                                                    No attachments
                                                </p>

                                                <p
                                                    class="mt-1 text-xs text-text-muted"
                                                >
                                                    No files were attached to this request.
                                                </p>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>


                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin"
                                >

                                    <div
                                        class="flex items-center justify-between border-b border-border px-5 py-4 sm:px-6"
                                    >

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-comments text-info"></i>

                                            <h3
                                                class="text-sm font-bold text-text-primary"
                                            >
                                                Comments
                                            </h3>

                                        </div>

                                        <span
                                            class="rounded-full bg-info-light px-2.5 py-1 text-xs font-semibold text-info-dark"
                                        >
                                            <%= serviceRequest.comments?.length || 0 %>
                                        </span>

                                    </div>


                                    <div class="space-y-3 px-5 py-5 sm:px-6">

                                        <% if (serviceRequest.comments?.length) { %>

                                            <% serviceRequest.comments.forEach((comment) => { %>

                                                <%
                                                    const commentUser = comment.user;

                                                    const commentName = commentUser
                                                        ? `${commentUser.firstname || ""} ${commentUser.lastname || ""}`.trim()
                                                        : "Unknown User";

                                                    const commentInitial =
                                                        commentUser?.firstname
                                                            ? commentUser.firstname.charAt(0).toUpperCase()
                                                            : "U";
                                                %>

                                                <div
                                                    class="rounded-xl border border-border bg-surface-soft px-4 py-4"
                                                >

                                                    <div class="flex items-start gap-3">

                                                        <div
                                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-info-light text-sm font-semibold text-info"
                                                        >
                                                            <%= commentInitial %>
                                                        </div>

                                                        <div class="min-w-0 flex-1">

                                                            <div
                                                                class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between"
                                                            >

                                                                <div>

                                                                    <p
                                                                        class="text-sm font-semibold text-text-primary"
                                                                    >
                                                                        <%= commentName %>
                                                                    </p>

                                                                    <p
                                                                        class="text-xs text-text-muted"
                                                                    >
                                                                        <%= commentUser?.role || "User" %>
                                                                    </p>

                                                                </div>

                                                                <p
                                                                    class="text-xs text-text-muted"
                                                                >
                                                                    <%= comment.createdAt
                                                                        ? new Date(comment.createdAt).toLocaleString("en-IN", {
                                                                            day: "2-digit",
                                                                            month: "short",
                                                                            year: "numeric",
                                                                            hour: "2-digit",
                                                                            minute: "2-digit"
                                                                        })
                                                                        : "-"
                                                                    %>
                                                                </p>

                                                            </div>


                                                            <p
                                                                class="mt-3 whitespace-pre-wrap text-sm leading-6 text-text-secondary"
                                                            >
                                                                <%= comment.comment ||
                                                                    comment.message ||
                                                                    comment.text ||
                                                                    "" %>
                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>

                                            <% }); %>

                                        <% } else { %>

                                            <div
                                                class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                            >

                                                <div
                                                    class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                                >
                                                    <i class="fa-regular fa-comment"></i>
                                                </div>

                                                <p
                                                    class="mt-3 text-sm font-semibold text-text-primary"
                                                >
                                                    No comments yet
                                                </p>

                                                <p
                                                    class="mt-1 text-xs text-text-muted"
                                                >
                                                    No comments have been added to this request.
                                                </p>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>

                            </div>


                            <div class="space-y-5">



                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin"
                                >

                                    <div
                                        class="border-b border-border px-5 py-4"
                                    >

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-circle-info text-accent"></i>

                                            <h3
                                                class="text-sm font-bold text-text-primary"
                                            >
                                                Request Information
                                            </h3>

                                        </div>

                                    </div>


                                    <div class="space-y-4 px-5 py-5">


                                        <!-- Request ID -->

                                        <div>

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Request ID
                                            </p>

                                            <p
                                                class="mt-1 break-all font-mono text-xs text-text-secondary"
                                            >
                                                <%= serviceRequest._id %>
                                            </p>

                                        </div>


                                        <!-- Created -->

                                        <div>

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Created At
                                            </p>

                                            <p
                                                class="mt-1 text-sm font-medium text-text-primary"
                                            >
                                                <%= serviceRequest.createdAt
                                                    ? new Date(serviceRequest.createdAt).toLocaleString("en-IN", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric",
                                                        hour: "2-digit",
                                                        minute: "2-digit"
                                                    })
                                                    : "-"
                                                %>
                                            </p>

                                        </div>


                                        <!-- Updated -->

                                        <div>

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Last Updated
                                            </p>

                                            <p
                                                class="mt-1 text-sm font-medium text-text-primary"
                                            >
                                                <%= serviceRequest.updatedAt
                                                    ? new Date(serviceRequest.updatedAt).toLocaleString("en-IN", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric",
                                                        hour: "2-digit",
                                                        minute: "2-digit"
                                                    })
                                                    : "-"
                                                %>
                                            </p>

                                        </div>


                                        <!-- Status -->

                                        <div>

                                            <p
                                                class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                                            >
                                                Current Status
                                            </p>

                                            <div class="mt-2">

                                                <% if (serviceRequest.status === "pending") { %>

                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-warning-light px-3 py-1.5 text-xs font-semibold text-warning-dark">
                                                        <i class="fa-solid fa-clock"></i>
                                                        Pending
                                                    </span>

                                                <% } else if (serviceRequest.status === "assigned") { %>

                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-info-light px-3 py-1.5 text-xs font-semibold text-info-dark">
                                                        <i class="fa-solid fa-user-check"></i>
                                                        Assigned
                                                    </span>

                                                <% } else if (serviceRequest.status === "in_progress") { %>

                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1.5 text-xs font-semibold text-brand">
                                                        <i class="fa-solid fa-spinner"></i>
                                                        In Progress
                                                    </span>

                                                <% } else if (serviceRequest.status === "completed") { %>

                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-success-light px-3 py-1.5 text-xs font-semibold text-success-dark">
                                                        <i class="fa-solid fa-circle-check"></i>
                                                        Completed
                                                    </span>

                                                <% } %>

                                            </div>

                                        </div>


                                    </div>

                                </div>


                                <div
                                    class="rounded-admin-xl border-[2.1px] border-brand bg-card  hover:shadow-admin"
                                >

                                    <div
                                        class="border-b border-border px-5 py-4"
                                    >

                                        <div class="flex items-center gap-2">

                                            <i class="fa-solid fa-clock-rotate-left text-accent"></i>

                                            <h3
                                                class="text-sm font-bold text-text-primary"
                                            >
                                                Activity History
                                            </h3>

                                        </div>

                                    </div>


                                    <div class="space-y-3 px-5 py-5">

                                        <% if (serviceRequest.history?.length) { %>

                                            <% serviceRequest.history.forEach((item) => { %>

                                                <%
                                                    const actor = item.actor;

                                                    const actorName = actor
                                                        ? `${actor.firstname || ""} ${actor.lastname || ""}`.trim()
                                                        : "System";

                                                    const actorInitial =
                                                        actor?.firstname
                                                            ? actor.firstname.charAt(0).toUpperCase()
                                                            : "S";

                                                    const action =
                                                        item.action ||
                                                        item.activity ||
                                                        item.description ||
                                                        "Service request updated";
                                                %>

                                                <div
                                                    class="rounded-xl border border-border bg-surface-soft px-4 py-4"
                                                >

                                                    <div class="flex items-start gap-3">

                                                        <div
                                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent"
                                                        >
                                                            <%= actorInitial %>
                                                        </div>

                                                        <div class="min-w-0 flex-1">

                                                            <div
                                                                class="flex flex-col gap-1"
                                                            >

                                                                <p
                                                                    class="text-sm font-semibold text-text-primary"
                                                                >
                                                                    <%= action %>
                                                                </p>

                                                                <p
                                                                    class="text-xs text-text-muted"
                                                                >
                                                                    <%= item.createdAt
                                                                        ? new Date(item.createdAt).toLocaleString("en-IN", {
                                                                            day: "2-digit",
                                                                            month: "short",
                                                                            year: "numeric",
                                                                            hour: "2-digit",
                                                                            minute: "2-digit"
                                                                        })
                                                                        : "-"
                                                                    %>
                                                                </p>

                                                            </div>


                                                            <p
                                                                class="mt-1 text-xs text-text-secondary"
                                                            >
                                                                By
                                                                <span class="font-semibold text-text-primary">
                                                                    <%= actorName %>
                                                                </span>
                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>

                                            <% }); %>

                                        <% } else { %>

                                            <div
                                                class="rounded-xl border border-dashed border-border bg-surface-soft px-4 py-8 text-center"
                                            >

                                                <div
                                                    class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-page-background text-text-muted"
                                                >
                                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                                </div>

                                                <p
                                                    class="mt-3 text-sm font-semibold text-text-primary"
                                                >
                                                    No activity history
                                                </p>

                                                <p
                                                    class="mt-1 text-xs text-text-muted"
                                                >
                                                    No activity has been recorded yet.
                                                </p>

                                            </div>

                                        <% } %>

                                    </div>

                                </div>


                            </div>

                        </div>



                        <div
                            class="flex flex-col gap-3 rounded-admin-xl  p-4 border-[2.1px] border-brand bg-card   hover:shadow-admin sm:flex-row sm:justify-end"
                        >

                            <a
                                href="/admin/servicerequest"
                                class="inline-flex h-10 items-center justify-center gap-2 rounded-admin border border-border bg-card px-5 text-sm font-semibold text-text-secondary transition hover:bg-page-background hover:text-text-primary"
                            >
                                <i class="fa-solid fa-arrow-left"></i>
                                Back to Requests
                            </a>


                            <% if (serviceRequest.status === "pending") { %>

                                <button
                                    type="button"
                                    class="assign-staff-btn inline-flex h-10 items-center justify-center gap-2 rounded-admin bg-brand px-5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                    data-id="<%= serviceRequest._id %>"
                                >
                                    <i class="fa-solid fa-user-plus"></i>
                                    Assign Staff
                                </button>

                            <% } else { %>

                                <button
                                    type="button"
                                    class="reassign-staff-btn inline-flex h-10 items-center justify-center gap-2 rounded-admin bg-brand px-5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                    data-id="<%= serviceRequest._id %>"
                                >
                                    <i class="fa-solid fa-user-gear"></i>
                                    Reassign Staff
                                </button>

                            <% } %>


                            <button
                                type="button"
                                class="update-status-btn inline-flex h-10 items-center justify-center gap-2 rounded-admin bg-success-dark px-5 text-sm font-semibold text-white transition hover:opacity-90"
                                data-id="<%= serviceRequest._id %>"
                                data-status="<%= serviceRequest.status %>"
                            >
                                <i class="fa-solid fa-arrows-rotate"></i>
                                Update Status
                            </button>

                        </div>


                    </div>

                <% } %>

            </section>

        </main>

    </div>



    <%- include("assignStaff") %>


    <!-- Existing service request actions -->

    <script src="/js/serviceReq.js"></script>

</body>

</html>
