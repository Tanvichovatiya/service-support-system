
<div
    id="updateStatusModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 px-4 py-6 backdrop-blur-sm"
>
    <div
        class="relative flex max-h-[90vh] w-full max-w-lg flex-col overflow-hidden rounded-2xl border-2 border-accent-dark bg-accent-soft shadow-admin-lg"
    >


        <div
            class="flex items-center justify-between border-b border-border-light bg-accent-soft px-5 py-4 sm:px-6"
        >
            <div class="flex min-w-0 items-center gap-3">

                <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-success-light text-success"
                >
                    <i
                        class="fa-solid fa-arrows-rotate text-sm"
                    ></i>
                </div>

                <div class="min-w-0">

                    <h2
                        class="truncate text-lg font-bold text-heading"
                    >
                        Update Request Status
                    </h2>

                    <p
                        class="mt-0.5 truncate text-xs text-text-secondary"
                    >
                        Change the current service request status
                    </p>

                </div>
            </div>

            <button
                type="button"
                id="closeUpdateStatusModal"
                class="ml-4 flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-accent-light transition hover:bg-danger-light hover:text-danger focus:outline-none focus:ring-4 focus:ring-accent-soft"
                aria-label="Close modal"
            >
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>

        </div>


        <div
            id="updateStatusLoading"
            class="hidden flex-1 items-center justify-center bg-surface px-6 py-16"
        >
            <div class="text-center">

                <div
                    class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent"
                >
                    <i class="fa-solid fa-spinner fa-spin"></i>
                </div>

                <p
                    class="mt-4 text-sm font-semibold text-text-primary"
                >
                    Updating request
                </p>

                <p
                    class="mt-1 text-xs text-text-secondary"
                >
                    Please wait...
                </p>

            </div>
        </div>


        <form
            id="updateStatusForm"
            class="overflow-y-auto bg-surface px-5 py-5 sm:px-6 sm:py-6"
        >

            <input
                type="hidden"
                id="updateStatusRequestId"
            />

       

            <div
                class="mb-5 rounded-xl border border-border bg-surface-soft px-4 py-4"
            >

                <div class="flex items-center gap-3">

                    <div
                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand"
                    >
                        <i class="fa-solid fa-ticket"></i>
                    </div>

                    <div class="min-w-0">

                        <p
                            class="text-xs font-medium uppercase tracking-wide text-text-muted"
                        >
                            Service Request
                        </p>

                        <p
                            id="updateStatusRequestTitle"
                            class="mt-0.5 truncate text-sm font-bold text-text-primary"
                        >
                            Service Request
                        </p>

                    </div>

                </div>

            </div>


            <!-- Current Status -->

            <div class="mb-5">

                <label
                    class="mb-2 block text-sm font-semibold text-text-primary"
                >
                    Current Status
                </label>

                <div
                    id="currentStatusBadge"
                    class="flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3.5"
                >

                    <div
                        id="currentStatusIcon"
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-warning-light text-warning-dark"
                    >
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div>

                        <p
                            class="text-xs text-text-secondary"
                        >
                            Current status
                        </p>

                        <p
                            id="currentStatusText"
                            class="mt-0.5 text-sm font-bold text-text-primary"
                        >
                            Pending
                        </p>

                    </div>

                </div>

            </div>


            <!-- New Status -->

            <div class="mb-5">

                <label
                    for="newRequestStatus"
                    class="mb-2 block text-sm font-semibold text-text-primary"
                >
                    New Status

                    <span class="ml-0.5 text-danger">
                        *
                    </span>
                </label>

                <div class="group relative">

                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-text-muted transition-colors group-focus-within:text-accent"
                    >
                        <i class="fa-solid fa-list-check text-sm"></i>
                    </div>

                    <select
                        id="newRequestStatus"
                        name="status"
                        required
                        class="h-12 w-full appearance-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-11 text-sm text-text-primary outline-none transition-all duration-200 hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                    >
                        <option value="">
                            Select new status
                        </option>
                    </select>

                    <i
                        class="fa-solid fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-text-muted"
                    ></i>

                </div>

                <p
                    id="newStatusError"
                    class="mt-1.5 hidden text-xs font-medium text-danger"
                ></p>

            </div>


            <!-- Status Flow -->

            <div
                class="rounded-xl border border-info/20 bg-info-light/30 px-4 py-4"
            >

                <div class="flex items-start gap-3">

                    <div
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-info-light text-info"
                    >
                        <i class="fa-solid fa-circle-info text-sm"></i>
                    </div>

                    <div class="min-w-0">

                        <p
                            class="text-sm font-semibold text-text-primary"
                        >
                            Status transition
                        </p>

                        <p
                            id="statusTransitionText"
                            class="mt-1 text-xs leading-5 text-text-secondary"
                        >
                            Select a new status to continue.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Warning -->

            <div
                id="statusWarning"
                class="mt-4 hidden rounded-xl border border-danger/20 bg-danger-light px-4 py-3.5"
            >

                <div class="flex items-start gap-3">

                    <i
                        class="fa-solid fa-triangle-exclamation mt-0.5 text-danger"
                    ></i>

                    <p
                        class="text-xs leading-5 text-danger-dark"
                    >
                        Cancelling a service request is a significant action.
                        Make sure the request should no longer be processed.
                    </p>

                </div>

            </div>

        </form>


        <!-- ==================================================
             FOOTER
        =================================================== -->

        <div
            class="flex flex-col-reverse gap-2.5 border-t border-border-light bg-surface px-5 py-4 sm:flex-row sm:justify-end sm:px-6"
        >

            <button
                type="button"
                id="cancelUpdateStatusModal"
                class="w-full cursor-pointer rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all duration-200 hover:border-border-dark hover:bg-surface-soft hover:text-text-primary focus:outline-none focus:ring-4 focus:ring-accent-soft sm:w-auto"
            >
                Cancel
            </button>

            <button
                type="submit"
                id="updateStatusButton"
                form="updateStatusForm"
                class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-admin-sm transition-all duration-200 hover:bg-accent-dark hover:shadow-admin focus:outline-none focus:ring-4 focus:ring-accent-soft sm:w-auto"
            >

                <i
                    id="updateStatusButtonIcon"
                    class="fa-solid fa-check text-xs"
                ></i>

                <span id="updateStatusButtonText">
                    Update Status
                </span>

            </button>

        </div>

    </div>
</div>
