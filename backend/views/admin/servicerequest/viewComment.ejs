

<div
    id="viewCommentModal"
    class="fixed inset-0 mx-auto z-[100] hidden items-center justify-center bg-black/40 px-4 py-6 backdrop-blur-sm"
>
    <div
        class="relative flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border-2 border-accent-dark bg-accent-soft shadow-admin-lg">


    <div
        class="flex items-center justify-between border-b border-border-light bg-accent-soft px-5 py-4 sm:px-6">
        <div class="flex min-w-0 items-center gap-3">

            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-info-light text-info">
                <i class="fa-solid fa-comments text-sm"></i>
            </div>

            <div class="min-w-0">
                <h2 class="truncate text-lg font-bold text-heading">
                    Comments
                </h2>

                <p
                    id="viewCommentSubtitle"
                    class="mt-0.5 truncate text-xs text-text-secondary"
                >
                    Comments for this service request
                </p>
            </div>
        </div>

        <button
            type="button"
            id="closeViewCommentModal"
            class="ml-4 flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-accent-light transition hover:bg-danger-light hover:text-danger focus:outline-none focus:ring-4 focus:ring-accent-soft"
            aria-label="Close modal"
        >
            <i class="fa-solid fa-xmark text-sm"></i>
        </button>
    </div>


    <div class="border-b border-border-light bg-surface px-5 py-4 sm:px-6">
        <div
            class="flex items-center gap-3 rounded-xl border border-border bg-surface-soft px-4 py-3"
        >
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand"
            >
                <i class="fa-solid fa-ticket text-sm"></i>
            </div>

            <div class="min-w-0">
                <p
                    class="text-xs font-medium uppercase tracking-wide text-text-muted"
                >
                    Service Request
                </p>

                <p
                    id="viewCommentRequestTitle"
                    class="mt-0.5 truncate text-sm font-semibold text-text-primary"
                >
                    Service Request
                </p>
            </div>
        </div>
    </div>

    <div
        id="commentsContainer"
        class="min-h-[220px] flex-1 overflow-y-auto bg-surface px-5 py-5 sm:px-6"
    >

     
        <div
            id="commentsLoading"
            class="flex min-h-[220px] items-center justify-center"
        >
            <div class="text-center">
                <i
                    class="fa-solid fa-spinner fa-spin text-2xl text-brand"
                ></i>

                <p class="mt-3 text-sm font-medium text-text-secondary">
                    Loading comments...
                </p>
            </div>
        </div>


        <div
            id="commentsEmpty"
            class="hidden flex min-h-[220px] items-center justify-center"
        >
            <div class="text-center">

                <div
                    class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-info-light text-info"
                >
                    <i class="fa-regular fa-comments text-xl"></i>
                </div>

                <p
                    class="mt-4 font-semibold text-text-primary"
                >
                    No comments yet
                </p>

                <p
                    class="mt-1 text-sm text-text-muted"
                >
                    No comments have been added to this request.
                </p>
            </div>
        </div>


        <div
            id="commentsError"
            class="hidden flex min-h-[220px] items-center justify-center"
        >
            <div class="text-center">

                <div
                    class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-danger-light text-danger"
                >
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>

                <p
                    class="mt-4 font-semibold text-text-primary"
                >
                    Failed to load comments
                </p>

                <p
                    id="commentsErrorMessage"
                    class="mt-1 text-sm text-text-muted"
                >
                    Please try again.
                </p>

                <button
                    type="button"
                    id="retryCommentsButton"
                    class="mt-4 inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                    <i class="fa-solid fa-rotate-right"></i>
                    Retry
                </button>
            </div>
        </div>


        <div
            id="commentsList"
            class="hidden space-y-4"
        ></div>

    </div>

    <div
        class="flex items-center justify-between gap-3 border-t border-border-light bg-surface px-5 py-4 sm:px-6"
    >
        <p
            id="commentCount"
            class="text-xs font-medium text-text-muted"
        >
            0 comments
        </p>

        <button
            type="button"
            id="closeViewCommentModalFooter"
            class="cursor-pointer rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all hover:border-border-dark hover:bg-surface-soft hover:text-text-primary"
        >
            Close
        </button>
    </div>

</div>


</div>
