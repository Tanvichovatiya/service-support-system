
<div
    id="reassignStaffModal"
    class="fixed inset-0 z-[100] hidden h-dvh w-full items-center justify-center bg-overlay px-3 py-3 backdrop-blur-sm sm:px-4 sm:py-5"
>
    <div
        class="relative flex h-[calc(100dvh-1.5rem)] w-full max-w-4xl flex-col overflow-hidden rounded-admin-xl border border-border bg-surface shadow-admin-md sm:h-[calc(100dvh-2.5rem)]"
    >
        <div
            class="flex shrink-0 items-center justify-between border-b border-border-light bg-brand-soft px-4 py-3.5 sm:px-6 sm:py-4"
        >
            <div class="flex min-w-0 items-center gap-3">
                <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-admin bg-brand-muted text-brand"
                >
                    <i class="fa-solid fa-user-gear"></i>
                </div>

                <div class="min-w-0">
                    <h2
                        class="truncate text-base font-bold text-heading sm:text-lg"
                    >
                        Reassign Staff
                    </h2>

                    <p
                        class="mt-0.5 truncate text-xs text-text-secondary"
                    >
                        Update the assigned staff members for this request
                    </p>
                </div>
            </div>

            <button
                type="button"
                id="closeReassignStaffModal"
                class="ml-3 flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-admin-sm text-text-muted transition hover:bg-danger-light hover:text-danger focus:outline-none focus:ring-4 focus:ring-accent-soft"
                aria-label="Close modal"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div
            id="reassignStaffLoading"
            class="hidden min-h-0 flex-1 items-center justify-center overflow-hidden bg-surface px-6 py-12"
        >
            <div class="text-center">
                <div
                    class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-soft text-brand"
                >
                    <i class="fa-solid fa-spinner fa-spin"></i>
                </div>

                <p
                    class="mt-4 text-sm font-semibold text-text-primary"
                >
                    Loading staff
                </p>

                <p
                    class="mt-1 text-xs text-text-secondary"
                >
                    Please wait...
                </p>
            </div>
        </div>

        <form
            id="reassignStaffForm"
            class="min-h-0 min-w-0 flex-1 overflow-y-auto overscroll-contain bg-surface px-4 py-4 sm:px-6 sm:py-5"
        >
            <input
                type="hidden"
                id="reassignRequestId"
            />

            <div
                class="mb-5 rounded-admin border border-border bg-surface-soft px-4 py-4"
            >
                <div class="flex items-center gap-3">
                    <div
                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-admin-sm bg-brand-soft text-brand"
                    >
                        <i class="fa-solid fa-ticket"></i>
                    </div>

                    <div class="min-w-0">
                        <p
                            class="text-[11px] font-semibold uppercase tracking-wide text-text-muted"
                        >
                            Service Request
                        </p>

                        <p
                            id="reassignRequestTitle"
                            class="mt-0.5 truncate text-sm font-bold text-heading sm:text-base"
                        >
                            Service Request
                        </p>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <div
                    class="mb-2 flex items-center justify-between gap-2"
                >
                    <label
                        class="text-sm font-semibold text-text-primary"
                    >
                        Currently Assigned Staff
                    </label>

                    <span
                        class="rounded-full bg-info-light px-2.5 py-1 text-[10px] font-semibold text-info sm:text-[11px]"
                    >
                        Current
                    </span>
                </div>

                <div
                    id="currentStaffList"
                    class="grid grid-cols-1 gap-2 sm:grid-cols-2"
                ></div>
            </div>

            <div
                class="mb-5 rounded-admin border border-border bg-surface-soft p-3.5 sm:p-4"
            >
                <div
                    class="mb-4 flex flex-wrap items-center justify-between gap-2"
                >
                    <div class="flex min-w-0 items-center gap-2">
                        <div
                            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-admin-sm bg-brand-soft text-brand"
                        >
                            <i class="fa-solid fa-users text-xs"></i>
                        </div>

                        <div class="min-w-0">
                            <p
                                class="truncate text-sm font-semibold text-text-primary"
                            >
                                Reassign To
                            </p>

                            <p
                                class="mt-0.5 text-[11px] text-text-muted"
                            >
                                Select staff members
                            </p>
                        </div>
                    </div>

                    <span
                        class="rounded-full bg-brand-soft px-2.5 py-1 text-[10px] font-semibold text-brand sm:text-[11px]"
                    >
                        Multiple selection
                    </span>
                </div>

                <div
                    id="reassignStaffList"
                    class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
                ></div>

                <p
                    id="reassignStaffError"
                    class="mt-3 hidden text-xs font-medium text-danger"
                ></p>
            </div>

            <div
                class="mb-5 overflow-hidden rounded-admin border border-brand-muted bg-brand-soft/30"
            >
                <div
                    class="flex items-center justify-between border-b border-brand-muted bg-brand-soft/50 px-4 py-3.5 sm:px-5"
                >
                    <div class="flex min-w-0 items-center gap-3">
                        <div
                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-admin-sm bg-brand text-white shadow-sm"
                        >
                            <i class="fa-solid fa-user-check text-xs"></i>
                        </div>

                        <div class="min-w-0">
                            <p
                                class="truncate text-sm font-bold text-text-primary"
                            >
                                Selected Staff
                            </p>

                            <p
                                class="mt-0.5 text-[11px] text-text-muted"
                            >
                                Unselect current staff or select additional staff members
                            </p>
                        </div>
                    </div>

                    <div
                        class="flex shrink-0 items-center gap-1.5 rounded-full border border-brand-muted bg-surface px-2.5 py-1"
                    >
                        <i class="fa-solid fa-users text-[9px] text-brand"></i>

                        <span
                            id="selectedStaffCount"
                            class="text-[11px] font-bold text-brand"
                        >
                            0
                        </span>
                    </div>
                </div>

                <div class="p-3.5 sm:p-4">
                    <div
                        id="selectedStaffList"
                        class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
                    ></div>
                </div>
            </div>

            <div
                class="rounded-admin border border-warning/30 bg-warning-light px-3.5 py-3.5 sm:px-4"
            >
                <div class="flex items-start gap-3">
                    <div
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-warning-light text-warning-dark"
                    >
                        <i
                            class="fa-solid fa-triangle-exclamation text-sm"
                        ></i>
                    </div>

                    <div class="min-w-0">
                        <p
                            class="text-xs font-semibold text-text-primary sm:text-sm"
                        >
                            Reassign Request
                        </p>

                        <p
                            class="mt-1 text-[11px] leading-5 text-text-secondary sm:text-xs"
                        >
                            Current staff are selected by default. Unselect a staff member to remove them, or select another staff member to add them.
                        </p>
                    </div>
                </div>
            </div>
        </form>

        <div
            class="flex shrink-0 flex-col-reverse gap-2 border-t border-border-light bg-surface px-4 py-3.5 sm:flex-row sm:justify-end sm:px-6 sm:py-4"
        >
            <button
                type="button"
                id="cancelReassignStaff"
                class="w-full cursor-pointer rounded-admin border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text-secondary transition hover:border-border-dark hover:bg-surface-soft hover:text-text-primary focus:outline-none focus:ring-4 focus:ring-brand-soft sm:w-auto"
            >
                Cancel
            </button>

            <button
                type="submit"
                id="reassignStaffSubmit"
                form="reassignStaffForm"
                disabled
                class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-admin-sm transition-all duration-200 hover:bg-brand-dark hover:shadow-admin disabled:cursor-not-allowed disabled:opacity-50 focus:outline-none focus:ring-4 focus:ring-brand-soft sm:w-auto"
            >
                <i
                    id="reassignStaffSubmitIcon"
                    class="fa-solid fa-user-gear text-xs"
                ></i>

                <span id="reassignStaffSubmitText">
                    Reassign Staff
                </span>
            </button>
        </div>
    </div>
</div>
