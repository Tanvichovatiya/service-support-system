

<div
    id="createRequestModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 px-4 py-6 backdrop-blur-sm"
>
    <div
        class="relative flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl border-2 border-accent-dark bg-accent-soft shadow-admin-lg"
    >

    

        <div
            class="flex items-center justify-between border-b border-border-light bg-accent-soft px-5 py-4 sm:px-6"
        >
            <div class="flex min-w-0 items-center gap-3">

                <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
                >
                    <i class="fa-solid fa-ticket text-sm"></i>
                </div>

                <div class="min-w-0">

                    <h2
                        class="truncate text-lg font-bold text-heading"
                    >
                        Create Service Request
                    </h2>

                    <p
                        class="mt-0.5 truncate text-xs text-text-secondary"
                    >
                        Create a service request on behalf of a user
                    </p>

                </div>

            </div>

            <button
                type="button"
                id="closeCreateRequestModal"
                class="ml-4 flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-accent-light transition hover:bg-danger-light hover:text-danger focus:outline-none focus:ring-4 focus:ring-accent-soft"
                aria-label="Close modal"
            >
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>

        </div>


        <!-- =================================================
             LOADING
        ================================================== -->

        <div
            id="createRequestLoading"
            class="hidden flex-1 items-center justify-center bg-surface px-6 py-16"
        >
            <div class="text-center">

                <div
                    class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent"
                >
                    <i class="fa-solid fa-spinner fa-spin"></i>
                </div>

                <p
                    class="mt-4 text-sm font-semibold text-text-primary"
                >
                    Creating request
                </p>

                <p
                    class="mt-1 text-xs text-text-secondary"
                >
                    Please wait...
                </p>

            </div>
        </div>



        <form
            id="createRequestForm"
            class="overflow-y-auto bg-surface px-5 py-5 sm:px-6 sm:py-6"
        >



            <div class="mb-5">

                <label
                    for="requestCategoryId"
                    class="mb-2 block text-sm font-semibold text-text-primary"
                >
                    Service Category

                    <span class="ml-0.5 text-danger">
                        *
                    </span>
                </label>

                <div class="group relative">

                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-text-muted transition-colors group-focus-within:text-accent"
                    >
                        <i class="fa-solid fa-layer-group text-sm"></i>
                    </div>

                    <select
                        id="requestCategoryId"
                        name="categoryId"
                        class="w-full cursor-pointer appearance-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-10 text-sm text-text-primary outline-none transition-all duration-200 hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                    >
                        <option value="">
                            Select category
                        </option>
                    </select>

                    <div
                        class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-text-muted"
                    >
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </div>

                </div>

                <p
                    id="requestCategoryIdError"
                    class="mt-1.5 hidden text-xs font-medium text-danger"
                ></p>

            </div>


            <!-- =============================================
                 TITLE
            ============================================== -->

            <div class="mb-5">

                <label
                    for="requestTitle"
                    class="mb-2 block text-sm font-semibold text-text-primary"
                >
                    Request Title

                    <span class="ml-0.5 text-danger">
                        *
                    </span>
                </label>

                <div class="group relative">

                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-text-muted transition-colors group-focus-within:text-accent"
                    >
                        <i class="fa-solid fa-heading text-sm"></i>
                    </div>

                    <input
                        type="text"
                        id="requestTitle"
                        name="title"
                        maxlength="200"
                        autocomplete="off"
                        placeholder="e.g. Unable to login to account"
                        class="w-full rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-text-primary outline-none transition-all duration-200 placeholder:text-input-placeholder hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                    />

                </div>

                <div class="mt-1.5 flex justify-between">

                    <p
                        id="requestTitleError"
                        class="hidden text-xs font-medium text-danger"
                    ></p>

                    <span
                        id="requestTitleCount"
                        class="ml-auto text-xs text-text-muted"
                    >
                        0/200
                    </span>

                </div>

            </div>


            <!-- =============================================
                 DESCRIPTION
            ============================================== -->

            <div class="mb-5">

                <div class="mb-2 flex items-center justify-between">

                    <label
                        for="requestDescription"
                        class="text-sm font-semibold text-text-primary"
                    >
                        Description

                        <span class="ml-0.5 text-danger">
                            *
                        </span>
                    </label>

                    <span
                        class="text-xs text-text-muted"
                    >
                        Required
                    </span>

                </div>

                <div class="group relative">

                    <div
                        class="pointer-events-none absolute left-0 top-0 flex w-11 items-start justify-center pt-3.5 text-text-muted transition-colors group-focus-within:text-accent"
                    >
                        <i class="fa-solid fa-align-left text-sm"></i>
                    </div>

                    <textarea
                        id="requestDescription"
                        name="description"
                        rows="5"
                        placeholder="Describe the issue or service requirement..."
                        class="w-full resize-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm leading-6 text-text-primary outline-none transition-all duration-200 placeholder:text-input-placeholder hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                    ></textarea>

                </div>

                <p
                    id="requestDescriptionError"
                    class="mt-1.5 hidden text-xs font-medium text-danger"
                ></p>

            </div>


            <!-- =============================================
                 PRIORITY
            ============================================== -->

            <div class="mb-1">

                <label
                    for="requestPriority"
                    class="mb-2 block text-sm font-semibold text-text-primary"
                >
                    Priority
                </label>

                <div class="group relative">

                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-text-muted transition-colors group-focus-within:text-accent"
                    >
                        <i class="fa-solid fa-flag text-sm"></i>
                    </div>

                    <select
                        id="requestPriority"
                        name="priority"
                        class="w-full cursor-pointer appearance-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-10 text-sm text-text-primary outline-none transition-all duration-200 hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                    >
                        <option value="low">
                            Low
                        </option>

                        <option value="medium" selected>
                            Medium
                        </option>

                        <option value="high">
                            High
                        </option>

                        <option value="urgent">
                            Urgent
                        </option>
                    </select>

                    <div
                        class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-text-muted"
                    >
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </div>

                </div>

            </div>

        </form>


        <!-- =================================================
             FOOTER
        ================================================== -->

        <div
            class="flex flex-col-reverse gap-2.5 border-t border-border-light bg-surface px-5 py-4 sm:flex-row sm:justify-end sm:px-6"
        >

            <button
                type="button"
                id="cancelCreateRequestModal"
                class="w-full cursor-pointer rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all duration-200 hover:border-border-dark hover:bg-surface-soft hover:text-text-primary focus:outline-none focus:ring-4 focus:ring-accent-soft sm:w-auto"
            >
                Cancel
            </button>

            <button
                type="submit"
                id="createRequestButton"
                form="createRequestForm"
                class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-admin-sm transition-all duration-200 hover:bg-accent-dark hover:shadow-admin focus:outline-none focus:ring-4 focus:ring-accent-soft sm:w-auto"
            >

                <i
                    id="createRequestButtonIcon"
                    class="fa-solid fa-check text-xs"
                ></i>

                <span id="createRequestButtonText">
                    Create Request
                </span>

            </button>

        </div>

    </div>
</div>