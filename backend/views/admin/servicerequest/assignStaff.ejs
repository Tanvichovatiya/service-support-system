<div
    id="assignStaffModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 px-4 py-6 backdrop-blur-sm"
>
    <div
        class="relative flex max-h-[90vh] w-full max-w-lg flex-col overflow-hidden rounded-2xl border-2 border-accent-dark bg-surface shadow-admin-lg"
    >
    <div
        class="flex items-center justify-between border-b border-border-light bg-accent-soft px-5 py-4 sm:px-6"
    >
        <div class="flex min-w-0 items-center gap-3">

            <!-- Icon -->
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"
            >
                <i class="fa-solid fa-user-plus text-sm"></i>
            </div>

            <!-- Title -->
            <div class="min-w-0">
                <h2
                    class="truncate text-lg font-bold text-heading"
                >
                    Assign Staff
                </h2>

                <p
                    class="mt-0.5 truncate text-xs text-text-secondary"
                >
                    Select an active staff member for this request
                </p>
            </div>
        </div>

        <!-- Close -->
        <button
            type="button"
            id="closeAssignStaffModal"
            class="ml-4 flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-accent-light transition hover:bg-danger-light hover:text-danger focus:outline-none focus:ring-4 focus:ring-accent-soft"
            aria-label="Close modal"
        >
            <i class="fa-solid fa-xmark text-sm"></i>
        </button>

    </div>


    <!-- ==================================================
         LOADING
    =================================================== -->

    <div
        id="assignStaffLoading"
        class="hidden flex-1 items-center justify-center bg-surface px-6 py-16"
    >
        <div class="text-center">

            <div
                class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent"
            >
                <i class="fa-solid fa-spinner fa-spin"></i>
            </div>

            <p
                class="mt-4 text-sm font-semibold text-text-primary"
            >
                Loading active staff
            </p>

            <p
                class="mt-1 text-xs text-text-secondary"
            >
                Please wait...
            </p>

        </div>
    </div>


    <!-- ==================================================
         FORM
    =================================================== -->

    <form
        id="assignStaffForm"
        class="overflow-y-auto bg-surface px-5 py-5 sm:px-6 sm:py-6"
    >

        <!-- Request ID -->
        <input
            type="hidden"
            id="assignRequestId"
            name="requestId"
        />


        <!-- ==================================================
             REQUEST INFORMATION
        =================================================== -->

        <div
            class="mb-5 rounded-xl border border-border bg-surface-soft px-4 py-4"
        >

            <div class="flex items-center gap-3">

                <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent"
                >
                    <i class="fa-solid fa-ticket text-sm"></i>
                </div>

                <div class="min-w-0">

                    <p
                        class="text-xs font-semibold uppercase tracking-wide text-text-muted"
                    >
                        Service Request
                    </p>

                    <p
                        id="assignRequestTitle"
                        class="mt-0.5 truncate text-sm font-bold text-heading"
                    >
                        Select staff for this request
                    </p>

                </div>

            </div>

        </div>


        <!-- ==================================================
             STAFF SELECT
        =================================================== -->

        <div class="mb-5">

            <label
                for="assignStaffSelect"
                class="mb-2 block text-sm font-semibold text-text-primary"
            >
                Staff Member

                <span class="ml-0.5 text-danger">
                    *
                </span>
            </label>


            <div class="group relative">

                <!-- Input Icon -->
                <div
                    class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-text-muted transition-colors group-focus-within:text-accent"
                >
                    <i class="fa-solid fa-user-tie text-sm"></i>
                </div>


                <!-- Select -->
                <select
                    id="assignStaffSelect"
                    name="staffId"
                    required
                    class="h-[46px] w-full cursor-pointer appearance-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-10 text-sm text-text-primary outline-none transition-all duration-200 hover:border-accent-light hover:bg-accent-soft/10 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent-soft"
                >
                    <option value="">
                        Select staff member
                    </option>
                </select>


                <!-- Dropdown Icon -->
                <i
                    class="fa-solid fa-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-text-muted transition-colors group-focus-within:text-accent"
                ></i>

            </div>


            <!-- Error -->
            <p
                id="assignStaffError"
                class="mt-1.5 hidden text-xs font-medium text-danger"
            ></p>

        </div>


        <!-- ==================================================
             STAFF INFO / HELPER
        =================================================== -->

        <div
            class="rounded-xl border border-border bg-background-soft px-4 py-3.5"
        >

            <div class="flex items-start gap-3">

                <div
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent"
                >
                    <i class="fa-solid fa-circle-info text-sm"></i>
                </div>

                <div>

                    <p
                        class="text-xs font-semibold text-text-primary"
                    >
                        Staff Assignment
                    </p>

                    <p
                        class="mt-0.5 text-xs leading-5 text-text-secondary"
                    >
                        Only active staff members are available for assignment.
                        The selected staff member will be assigned to this request.
                    </p>

                </div>

            </div>

        </div>

    </form>


    <!-- ==================================================
         FOOTER
    =================================================== -->

    <div
        class="flex flex-col-reverse gap-2.5 border-t border-border-light bg-surface px-5 py-4 sm:flex-row sm:justify-end sm:px-6"
    >

        <!-- Cancel -->
        <button
            type="button"
            id="cancelAssignStaff"
            class="w-full cursor-pointer rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-text-secondary transition-all duration-200 hover:border-border-dark hover:bg-surface-soft hover:text-text-primary focus:outline-none focus:ring-4 focus:ring-accent-soft sm:w-auto"
        >
            Cancel
        </button>


        <!-- Assign -->
        <button
            type="submit"
            id="assignStaffSubmit"
            form="assignStaffForm"
            class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-admin-sm transition-all duration-200 hover:bg-accent-dark hover:shadow-admin focus:outline-none focus:ring-4 focus:ring-accent-soft disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
        >

            <i
                id="assignStaffSubmitIcon"
                class="fa-solid fa-user-check text-xs"
            ></i>

            <span id="assignStaffSubmitText">
                Assign Staff
            </span>

        </button>

    </div>

</div>


</div>
