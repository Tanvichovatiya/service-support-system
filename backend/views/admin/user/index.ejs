
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Manage Users</title>

  <link
    rel="stylesheet"
    href="/css/output.css"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <%- include('../../partials/toast') %>

</head>

<body class="bg-page-background font-admin text-text antialiased">

<%
  const userList = Array.isArray(users) ? users : [];

  
  const currentQuery = filters || {};

  const paginationData = pagination || {};

  const totalUsers =Number(paginationData.totalUsers) || 0;

  const currentPage =Number(paginationData.currentPage) || 1;

  const pageLimit =Number(paginationData.limit) || 2;

  const totalPages =Number(paginationData.totalPages) || 1;

  const activeCount = userList.filter(
    (user) => user.isActive === true
  ).length;

  const inactiveCount = userList.filter(
    (user) => user.isActive === false
  ).length;

  const getInitials = (firstname, lastname) => {
    const first = String(firstname || "").trim();
    const last = String(lastname || "").trim();

    return (
      `${first.charAt(0)}${last.charAt(0)}`
    ).toUpperCase() || "US";
  };

  const getFullName = (firstname, lastname) => {
    return `${firstname || ""} ${lastname || ""}`.trim();
  };
%>

<div class="flex h-screen flex-col overflow-hidden md:flex-row">

 
  <%- include('../../partials/sidebar') %>

  <main class="flex min-w-0 flex-1 flex-col overflow-hidden">

   
    <header class="shrink-0 border-b border-border">

      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 sm:py-5 lg:px-8">

        <div class="flex items-start justify-between gap-4">

          <div class="min-w-0 flex-1">

            <div class="flex items-center gap-2">

              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand"
              >
                <i class="fa-solid fa-users text-sm"></i>
              </div>

              <span
                class="truncate text-xs font-semibold uppercase tracking-wide text-brand"
              >
                Administration
              </span>

            </div>

            <h1
              class="mt-2 text-xl font-bold tracking-tight text-heading sm:text-2xl lg:text-3xl"
            >
              Manage Users
            </h1>

            <p
              class="mt-1 max-w-xl text-xs leading-5 text-text-muted sm:text-sm"
            >
              View and manage registered users and their service requests.
            </p>

          </div>

           <a href="javascript:void(0)" id="openAddUserModal" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-admin bg-brand px-3 py-2.5 text-sm font-semibold text-white hover:shadow-admin-hover transition hover:bg-brand-dark sm:px-4">
                 <i class="fa-solid fa-plus"></i>

              <span class="sm:hidden md:inline">Add User</span>
            </a>

        </div>

      </div>

    </header>


    <section
      class="flex-1 overflow-y-auto overflow-x-hidden px-4 py-6 sm:px-6 sm:py-8">

      <div class="mx-auto max-w-7xl">


        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

          <div
            class="rounded-admin-lg border-[1.5px] border-brand bg-card p-5 hover:shadow-admin-hover">

            <div class="flex items-center justify-between gap-4">

              <div>

                <p class="text-sm font-medium text-text-muted">
                  Total Users
                </p>

                <p class="mt-2 text-3xl font-bold text-heading">
                  <%= totalUsers %>
                </p>

              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"
              >
                <i class="fa-solid fa-users"></i>
              </div>

            </div>

          </div>


         
          <div
            class="rounded-admin-lg border-[1.5px] border-brand bg-card p-5 hover:shadow-admin-hover"
          >

            <div class="flex items-center justify-between gap-4">

              <div>

                <p class="text-sm font-medium text-text-muted">
                  Active
                </p>

                <p class="mt-2 text-3xl font-bold text-success">
                  <%= activeCount %>
                </p>

              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-success-light text-success"
              >
                <i class="fa-solid fa-user-check"></i>
              </div>

            </div>

          </div>

          <div class="rounded-admin-lg border-[1.5px] border-brand bg-card p-5 hover:shadow-admin-hover">

            <div class="flex items-center justify-between gap-4">

              <div>

                <p class="text-sm font-medium text-text-muted">
                  Inactive
                </p>

                <p class="mt-2 text-3xl font-bold text-danger">
                  <%= inactiveCount %>
                </p>

              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-danger-light text-danger"
              >
                <i class="fa-solid fa-user-xmark"></i>
              </div>

            </div>

          </div>

        </div>


      
        <div class="mt-6 overflow-hidden rounded-admin-lg bg-card shadow-admin hover:border hover:border-brand"
        >

          <div class="border-b border-border px-4 py-5 sm:px-6">

            <div class="flex flex-col gap-5">

              <div
                class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between"
              >

                <div>

                  <div class="flex items-center gap-2">

                    <h2 class="text-lg font-bold text-heading">
                      Users
                    </h2>

                    <span
                      class="rounded-full bg-brand/10 px-2.5 py-1 text-xs font-semibold text-brand"
                    >
                      <%= totalUsers %>
                    </span>

                  </div>

                  <p class="mt-1 text-sm text-text-muted">
                    View and manage all registered users.
                  </p>

                </div>


                <form
                  method="GET"
                  action="/admin/user"
                  class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end"
                >

                
                  <div class="relative">

                    <i
                      class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-light"
                    ></i>

                    <input
                      type="text"
                      name="search"
                      value="<%= currentQuery.search || '' %>"
                      placeholder="Search by name..."
                      autocomplete="off"
                      class="w-full rounded-admin border border-border bg-page-background py-2.5 pl-10 pr-4 text-sm outline-none transition placeholder:text-text-light focus:border-brand focus:ring-2 focus:ring-brand/10"
                    />

                  </div>


                  <div class="relative">

                    <select
                      name="status"
                      class="w-full appearance-none rounded-admin border border-border bg-page-background px-4 py-2.5 pr-10 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/10"
                    >

                      <option
                        value="all"
                        <%= currentQuery.status === "all" ||
                            !currentQuery.status
                            ? "selected"
                            : "" %>
                      >
                        All Status
                      </option>

                      <option
                        value="active"
                        <%= currentQuery.status === "active"
                          ? "selected"
                          : "" %>
                      >
                        Active
                      </option>

                      <option
                        value="inactive"
                        <%= currentQuery.status === "inactive"
                          ? "selected"
                          : "" %>
                      >
                        Inactive
                      </option>

                    </select>

                    <i
                      class="fa-solid fa-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-text-light"
                    ></i>

                  </div>


                
                  <button
                    type="submit"
                    class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                  >
                    <i class="fa-solid fa-filter"></i>
                    <span>Filter</span>
                  </button>


                  
                  <% if (
                    currentQuery.search ||
                    (
                      currentQuery.status &&
                      currentQuery.status !== "all"
                    )
                  ) { %>

                    <a
                      href="/admin/user"
                      class="inline-flex items-center justify-center gap-2 rounded-admin border border-border bg-card px-5 py-2.5 text-sm font-semibold text-text-muted transition hover:bg-page-background"
                    >
                      <i class="fa-solid fa-xmark"></i>
                      <span>Clear</span>
                    </a>

                  <% } %>

                </form>

              </div>

            </div>

          </div>


          <% if (userList.length === 0) { %>

            <div class="px-6 py-16 text-center sm:py-20">

              <div
                class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-page-background text-text-light"
              >
                <i class="fa-solid fa-users text-2xl"></i>
              </div>

              <h3 class="mt-5 text-lg font-bold text-heading">

                <% if (
                  currentQuery.search ||
                  (
                    currentQuery.status &&
                    currentQuery.status !== "all"
                  )
                ) { %>

                  No matching users

                <% } else { %>

                  No users found

                <% } %>

              </h3>

              <p
                class="mx-auto mt-2 max-w-md text-sm leading-6 text-text-muted"
              >

                <% if (
                  currentQuery.search ||
                  (
                    currentQuery.status &&
                    currentQuery.status !== "all"
                  )
                ) { %>

                  Try changing your search or filter criteria.

                <% } else { %>

                  There are currently no registered users.

                <% } %>

              </p>

              <% if (
                currentQuery.search ||
                (
                  currentQuery.status &&
                  currentQuery.status !== "all"
                )
              ) { %>

                <a
                  href="/admin/user"
                  class="mt-6 inline-flex items-center gap-2 rounded-admin border border-border bg-card px-5 py-2.5 text-sm font-semibold text-text-muted transition hover:bg-page-background"
                >
                  <i class="fa-solid fa-rotate-left"></i>
                  Clear Filters
                </a>

              <% } %>

            </div>


          <% } else { %>


           
            <div class="w-full overflow-x-auto user-table-scrollbar">

              <table
                class="w-full min-w-[1000px] border-collapse text-left"
              >

                <thead>

                  <tr class="bg-table-header">

                    <th
                      class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      User
                    </th>

                    <th
                      class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      Email
                    </th>

                    <th
                      class="whitespace-nowrap px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      Service Requests
                    </th>

                    <th
                      class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      Status
                    </th>

                    <th
                      class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      Joined
                    </th>

                    <th
                      class="whitespace-nowrap px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-white"
                    >
                      Actions
                    </th>

                  </tr>

                </thead>


                <tbody class="divide-y divide-border">

                  <% userList.forEach((user) => { %>

                    <tr class="transition hover:bg-table-row-hover">


                      <!-- User -->
                      <td class="px-6 py-4">

                        <div class="flex items-center gap-3">

                          <div
                            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white"
                          >
                            <%= getInitials(
                              user.firstname,
                              user.lastname
                            ) %>
                          </div>

                          <div class="min-w-0">

                            <p
                              class="whitespace-nowrap font-semibold text-heading"
                            >
                              <%= getFullName(
                                user.firstname,
                                user.lastname
                              ) %>
                            </p>

                            <p
                              class="mt-0.5 text-sm text-text-muted"
                            >
                              User
                            </p>

                          </div>

                        </div>

                      </td>


                      <!-- Email -->
                      <td class="px-6 py-4">

                        <div class="flex items-center gap-2">

                          <i
                            class="fa-solid fa-envelope text-text-light"
                          ></i>

                          <span
                            class="max-w-[250px] truncate text-sm text-text"
                            title="<%= user.email || '' %>"
                          >
                            <%= user.email || "No email" %>
                          </span>

                        </div>

                      </td>


                      <!-- Service Requests -->
                      <td class="px-6 py-4 text-center">

                        <span
                          class="inline-flex min-w-10 items-center justify-center rounded-lg bg-brand/10 px-3 py-1.5 text-sm font-semibold text-brand"
                        >
                          <%= user.totalServiceRequests || 0 %>
                        </span>

                      </td>


                      <!-- Status -->
                      <td class="px-6 py-4">

                        <% if (user.isActive === true) { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-success-light px-3 py-1.5 text-xs font-semibold text-success"
                          >

                            <span
                              class="h-1.5 w-1.5 rounded-full bg-success"
                            ></span>

                            Active

                          </span>

                        <% } else { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger"
                          >

                            <span
                              class="h-1.5 w-1.5 rounded-full bg-danger"
                            ></span>

                            Inactive

                          </span>

                        <% } %>

                      </td>


                      <!-- Created At -->
                      <td class="px-6 py-4">

                        <span class="text-sm text-text-muted">

                          <%= user.createdAt
                            ? new Date(user.createdAt).toLocaleDateString(
                                "en-IN",
                                {
                                  day: "2-digit",
                                  month: "short",
                                  year: "numeric"
                                }
                              )
                            : "-"
                          %>

                        </span>

                      </td>


                      <!-- Actions -->
                      <td class="px-6 py-4 text-right">

                        <div
                          class="flex items-center justify-end gap-1"
                        >

                          <!-- View -->
                          <a
                            href="/admin/user/<%= user._id %>"
                            title="View User"
                            aria-label="View User"
                            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-text-muted transition hover:bg-brand/10 hover:text-brand"
                          >
                            <i class="fa-solid fa-eye"></i>
                          </a>


                         
                          <button
                            type="button"
                            data-user-id="<%= user._id %>"
                            title="Delete User"
                            aria-label="Delete User"
                            class="delete-user-btn inline-flex h-9 w-9 items-center justify-center rounded-lg text-text-muted transition hover:bg-danger-light hover:text-danger cursor-pointer"
                          >
                            <i class="fa-solid fa-trash"></i>
                          </button>

                        </div>

                      </td>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>


           

            <%- include('../../partials/pagination', {
              pagination:{
                page: currentPage,
                limit: pageLimit,
                totalPages: totalPages,
                totalItems: totalUsers
              },
              query: currentQuery,
              baseUrl: '/admin/user'
            }) %>


          <% } %>

        </div>

      </div>

    </section>

  </main>

</div>
 
<%- include("addUser") %>

<script>

  document.querySelectorAll(".delete-user-btn").forEach((button) => {

    button.addEventListener("click", async () => {

      const userId = button.dataset.userId;

   
      try {

        const response = await fetch(
          `/admin/user/${userId}/delete`,
          {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
            },
            credentials: "include",
          }
        );

        const result = await response.json();

       

        if (window.toast) {
          window.toast.success(
            result.message || "User deleted successfully."
          );
        }

        setTimeout(() => {
          window.location.reload();
        }, 700);

      } catch (error) {

        console.log("Delete user error:", error);

        if (window.toast) {

          window.toast.error(
            error.message ||
            "Something went wrong. Please try again."
          );

        }

      }

    });

  });

</script>
<script src="/js/addUser.js"></script>

<script src="/js/adminNotification.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/adminSocket.js"></script>

<script src="/js/adminNotificationPage.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    AdminNotification.getUnreadCount();
  });
</script>

</body>
</html>
