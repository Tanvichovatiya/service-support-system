<!-- Add User Modal -->
<div
  id="userModal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 px-4 py-6 backdrop-blur-sm"
>
  <div
    class="relative flex max-h-[90vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl border-2 border-accent-dark bg-accent-soft shadow-admin-lg"
  >
   
    <div
      class="flex items-center justify-between border-b border-border-light px-6 py-4"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent"
        >
          <i class="fa-solid fa-user-plus"></i>
        </div>

        <div>
          <h2 class="text-lg font-bold text-heading">
            Add User
          </h2>

          <p class="text-xs text-text-secondary">
            Create a new system user
          </p>
        </div>
      </div>

      <button
        type="button"
        id="closeUserModal"
        class="flex h-8 w-8 items-center justify-center rounded-lg text-text-secondary transition hover:bg-danger-light hover:text-danger cursor-pointer"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div
      id="userModalLoading"
      class="hidden items-center justify-center gap-3 border-b border-border-light bg-surface-soft px-6 py-4 text-sm text-text-secondary"
    >
      <i class="fa-solid fa-spinner fa-spin text-accent"></i>

      <span>
        Creating user...
      </span>
    </div>

    <form
      id="userForm"
      class="overflow-y-auto bg-surface px-6 py-6"
    >
      
      <div class="mb-4">
        <label
          for="userFirstname"
          class="mb-2 block text-sm font-semibold text-heading"
        >
          First Name <span class="text-danger">*</span>
        </label>

        <div class="relative">
          <div
            class="pointer-events-none absolute left-0 top-0 flex h-full w-11 items-center justify-center text-text-muted"
          >
            <i class="fa-solid fa-user"></i>
          </div>

          <input
            type="text"
            id="userFirstname"
            name="firstname"
            placeholder="Enter first name"
            autocomplete="given-name"
            class="w-full rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-heading outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-2 focus:ring-input-focus/10"
          />
        </div>

        <p
          id="userFirstnameError"
          class="mt-1 hidden text-xs text-danger"
        ></p>
      </div>

      <div class="mb-4">
        <label
          for="userLastname"
          class="mb-2 block text-sm font-semibold text-heading"
        >
          Last Name <span class="text-danger">*</span>
        </label>

        <div class="relative">
          <div
            class="pointer-events-none absolute left-0 top-0 flex h-full w-11 items-center justify-center text-text-muted"
          >
            <i class="fa-solid fa-user"></i>
          </div>

          <input
            type="text"
            id="userLastname"
            name="lastname"
            placeholder="Enter last name"
            autocomplete="family-name"
            class="w-full rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-heading outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-2 focus:ring-input-focus/10"
          />
        </div>

        <p
          id="userLastnameError"
          class="mt-1 hidden text-xs text-danger"
        ></p>
      </div>

   
      <div class="mb-4">
        <label
          for="userEmail"
          class="mb-2 block text-sm font-semibold text-heading"
        >
          Email <span class="text-danger">*</span>
        </label>

        <div class="relative">
          <div
            class="pointer-events-none absolute left-0 top-0 flex h-full w-11 items-center justify-center text-text-muted"
          >
            <i class="fa-solid fa-envelope"></i>
          </div>

          <input
            type="email"
            id="userEmail"
            name="email"
            placeholder="Enter email address"
            autocomplete="email"
            class="w-full rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-heading outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-2 focus:ring-input-focus/10"
          />
        </div>

        <p
          id="userEmailError"
          class="mt-1 hidden text-xs text-danger"
        ></p>
      </div>

      <div>
        <label
          for="userGender"
          class="mb-2 block text-sm font-semibold text-heading"
        >
          Gender
        </label>

        <div class="relative">
          <div
            class="pointer-events-none absolute left-0 top-0 flex h-full w-11 items-center justify-center text-text-muted"
          >
            <i class="fa-solid fa-venus-mars"></i>
          </div>

          <select
            id="userGender"
            name="gender"
            class="w-full appearance-none rounded-xl border border-input-border bg-input-background py-3 pl-11 pr-10 text-sm text-heading outline-none transition focus:border-input-focus focus:ring-2 focus:ring-input-focus/10"
          >
            <option value="">
              Select gender
            </option>

            <option value="Male">
              Male
            </option>

            <option value="Female">
              Female
            </option>

          </select>

          <div
            class="pointer-events-none absolute right-4 top-0 flex h-full items-center text-text-muted"
          >
            <i class="fa-solid fa-chevron-down text-xs"></i>
          </div>
        </div>
      </div>
    </form>

    <div
      class="flex justify-end gap-3 border-t border-border-light bg-surface px-6 py-4"
    >
      <button
        type="button"
        id="cancelUserModal"
        class="rounded-xl border border-border px-5 py-2.5 text-sm font-semibold text-text-secondary transition hover:bg-background-soft cursor-pointer"
      >
        Cancel
      </button>

      <button
        type="submit"
        form="userForm"
        id="saveUserButton"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer"
      >
        <span id="saveUserText">
          Create User
        </span>
<!-- 
        <i
          id="saveUserLoader"
          class="fa-solid fa-spinner fa-spin hidden"
        ></i> -->
      </button>
    </div>
  </div>
</div>