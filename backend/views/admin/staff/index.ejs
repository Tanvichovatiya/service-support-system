
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Manage Staff</title>

  <link
    rel="stylesheet"
    href="/css/output.css"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <%- include('../../partials/toast') %>
  
</head>

<body class="bg-page-background font-admin text-text antialiased">

<%
  const staffList = Array.isArray(staff) ? staff : [];
  const currentQuery = query || {};
  const paginationData = pagination || {};

  const totalStaff = Number(paginationData.totalItems) || 0;
  const currentPage = Number(paginationData.page) || 1;
  const pageLimit = Number(paginationData.limit) || 4;

  const onlineCount = staffList.filter(
    (member) => member.isOnline === true
  ).length;

  const activeCount = staffList.filter(
    (member) => member.isActive === true
  ).length;

  const getInitials = (firstname, lastname) => {
    const first = String(firstname || "").trim();
    const last = String(lastname || "").trim();

    return (
      `${first.charAt(0)}${last.charAt(0)}`
    ).toUpperCase() || "ST";
  };

  const getFullName = (firstname, lastname) => {
    return `${firstname || ""} ${lastname || ""}`.trim();
  };
%>

<div class="flex h-screen flex-col overflow-hidden md:flex-row">

  <%- include('../../partials/sidebar') %>

  <main class="flex min-w-0 flex-1 flex-col overflow-hidden">

    <header class="shrink-0 border-b border-border  ">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 sm:py-5 lg:px-8">

       <div class="flex items-start justify-between gap-4 ">

         <div class="min-w-0 flex-1">

       
          <div class="flex items-center gap-2">
          <div
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand"
          >
            <i class="fa-solid fa-users text-sm"></i>
          </div>

          <span class="truncate text-xs font-semibold uppercase tracking-wide text-brand">
            Administration
          </span>
           </div>

           <h1 class="mt-2 text-xl font-bold tracking-tight text-heading sm:text-2xl lg:text-3xl">
             Manage Staff
           </h1>

           <p class="mt-1 max-w-xl text-xs leading-5 text-text-muted sm:text-sm">
             Manage your support staff and their account access.
           </p>

         </div>

       <a
        href="/admin/staff/addStaff"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-admin bg-brand px-3 py-2.5 text-sm font-semibold text-white shadow-admin transition hover:bg-brand-dark sm:px-4"
        aria-label="Add Staff">
        <i class="fa-solid fa-plus"></i>

        <span class="sm:hidden md:inline">
          Add Staff
        </span>
       </a>

      </div>

     </div>
    </header>


    <section class="flex-1 overflow-y-auto overflow-x-hidden px-4 py-6 sm:px-6 sm:py-8">

      <div class="mx-auto max-w-7xl">

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

        

          <div class="rounded-admin-lg  bg-card p-5 border-[1.5px] border-brand hover:shadow-admin-hover">

            <div class="flex items-center justify-between gap-4 ">

              <div>
                <p class="text-sm font-medium text-text-muted">
                  Total Staff
                </p>

                <p class="mt-2 text-3xl font-bold text-heading">
                  <%= totalStaff %>
                </p>
              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"
              >
                <i class="fa-solid fa-users"></i>
              </div>

            </div>

          </div>


          <div class="rounded-admin-lg border-[1.5px] border-brand hover:shadow-admin-hover bg-card p-5">

            <div class="flex items-center justify-between gap-4">

              <div>
                <p class="text-sm font-medium text-text-muted">
                  Showing
                </p>

                <p class="mt-2 text-3xl font-bold text-heading">
                  <%= staffList.length %>
                </p>
              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600"
              >
                <i class="fa-solid fa-list"></i>
              </div>

            </div>

          </div>


          <div class="rounded-admin-lg border-[1.5px] border-brand hover:shadow-admin-hover bg-card p-5">

            <div class="flex items-center justify-between gap-4">

              <div>
                <p class="text-sm font-medium text-text-muted">
                  Online
                </p>

                <p class="mt-2 text-3xl font-bold text-brand-indigo">
                  <%= onlineCount %>
                </p>
              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-brand-indigo"
              >
                <i class="fa-solid fa-signal"></i>
              </div>

            </div>

          </div>


          <div class="rounded-admin-lg border-[1.5px] border-brand hover:shadow-admin-hover bg-card p-5 ">

            <div class="flex items-center justify-between gap-4">

              <div>
                <p class="text-sm font-medium text-text-muted">
                  Active
                </p>

                <p class="mt-2 text-3xl font-bold text-success">
                  <%= activeCount %>
                </p>
              </div>

              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-success-light text-success"
              >
                <i class="fa-solid fa-user-check"></i>
              </div>

            </div>

          </div>

        </div>


        <div class="mt-6 overflow-hidden rounded-admin-lg hover:border hover:border-brand bg-card shadow-admin ">


          <div class="border-b border-border px-4 py-5 sm:px-6">

            <div class="flex flex-col gap-5">

            

              <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">

                <div>

                  <div class="flex items-center gap-2">

                    <h2 class="text-lg font-bold text-heading">
                      Staff Members
                    </h2>

                    <span
                      class="rounded-full bg-brand/10 px-2.5 py-1 text-xs font-semibold text-brand"
                    >
                      <%= totalStaff %>
                    </span>

                  </div>

                  <p class="mt-1 text-sm text-text-muted">
                    View and manage all staff members.
                  </p>

                </div>
              
              <form
                method="GET"
                action="<%= baseUrl %>"
                class="flex gap-3 items-center justify-start md:justify-end"
              >


                <div class="relative">

                  <i
                    class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-light"
                  ></i>

                  <input
                    type="text"
                    name="search"
                    value="<%= currentQuery.search || '' %>"
                    placeholder="Search by name,department or employee ID..."
                    autocomplete="off"
                    class="w-full rounded-admin border border-border bg-page-background py-2.5 pl-10 pr-4 text-sm outline-none transition placeholder:text-text-light focus:border-brand focus:ring-2 focus:ring-brand/10"
                  />

                </div>

                <!-- Status -->

                <div class="relative">

                  <select
                    name="isOnline"
                    class="w-full appearance-none rounded-admin border border-border bg-page-background px-4 py-2.5 pr-10 text-sm outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/10"
                  >

                    <option
                      value=""
                      <%= !currentQuery.isOnline ? "selected" : "" %>
                    >
                      All Status
                    </option>

                    <option
                      value="true"
                      <%= currentQuery.isOnline === "true" ? "selected" : "" %>
                    >
                      Online
                    </option>

                    <option
                      value="false"
                      <%= currentQuery.isOnline === "false" ? "selected" : "" %>
                    >
                      Offline
                    </option>
                    

                  </select>
                    <i class="fa-solid fa-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-text-light" ></i>
              

                </div>

                <!-- Filter -->

                <button
                  type="submit"
                  class="inline-flex items-center justify-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                  <i class="fa-solid fa-filter"></i>
                  <span>Filter</span>
                </button>

                <!-- Clear -->

                <% if (currentQuery.search || currentQuery.isOnline) { %>

                  <a
                    href="<%= baseUrl %>"
                    class="inline-flex items-center justify-center gap-2 rounded-admin border border-border bg-card px-5 py-2.5 text-sm font-semibold text-text-muted transition hover:bg-page-background"
                  >
                    <i class="fa-solid fa-xmark"></i>
                    <span>Clear</span>
                  </a>

                <% } %>

              </form>

              </div>

             
            </div>

          </div>


          <% if (staffList.length === 0) { %>

            <div class="px-6 py-16 text-center sm:py-20">

              <div
                class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-page-background text-text-light"
              >
                <i class="fa-solid fa-users text-2xl"></i>
              </div>

              <h3 class="mt-5 text-lg font-bold text-heading">

                <% if (currentQuery.search || currentQuery.isOnline) { %>
                  No matching staff
                <% } else { %>
                  No staff members found
                <% } %>

              </h3>

              <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-text-muted">

                <% if (currentQuery.search || currentQuery.isOnline) { %>
                  Try changing your search or filter criteria.
                <% } else { %>
                  Add your first staff member to start managing your support team.
                <% } %>

              </p>

              <% if (currentQuery.search || currentQuery.isOnline) { %>

                <a
                  href="<%= baseUrl %>"
                  class="mt-6 inline-flex items-center gap-2 rounded-admin border border-border bg-card px-5 py-2.5 text-sm font-semibold text-text-muted transition hover:bg-page-background"
                >
                  <i class="fa-solid fa-rotate-left"></i>
                  Clear Filters
                </a>

              <% } else { %>

                <a
                  href="/admin/staff/addStaff"
                  class="mt-6 inline-flex items-center gap-2 rounded-admin bg-brand px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                  <i class="fa-solid fa-plus"></i>
                  Add Staff
                </a>

              <% } %>

            </div>

          <% } else { %>

          

            <div class="w-full overflow-x-auto staff-table-scrollbar">

              <table class="w-full min-w-[1200px] border-collapse text-left">


                <thead>

                  <tr class="bg-table-header">

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Staff
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Employee ID
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Department
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Skills
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Status
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-white">
                      Assigned
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-white">
                      In Progress
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-white">
                      Completed
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider text-white">
                      Total
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-xs font-semibold uppercase tracking-wider text-white">
                      Availability
                    </th>

                    <th class="whitespace-nowrap px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-white">
                      Actions
                    </th>

                  </tr>

                </thead>
                <tbody class="divide-y divide-border">

                  <% staffList.forEach((member) => { %>

                    <tr class="transition hover:bg-table-row-hover">

                      <td class="px-6 py-4">

                        <div class="flex items-center gap-3">

                          <div
                            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white"
                          >
                            <%= getInitials(member.firstname, member.lastname) %>
                          </div>

                          <div class="min-w-0">

                            <p class="whitespace-nowrap font-semibold text-heading">
                              <%= getFullName(member.firstname, member.lastname) %>
                            </p>

                            <p class="mt-0.5 max-w-[220px] truncate text-sm text-text-muted">
                              <%= member.email || "No email" %>
                            </p>

                          </div>

                        </div>

                      </td>

                      <td class="px-6 py-4">

                        <span
                          class="inline-flex items-center gap-1.5 rounded-lg bg-page-background px-2.5 py-1.5 font-mono text-xs font-semibold text-text"
                        >
                          <i class="fa-solid fa-id-badge text-text-light"></i>
                          <%= member.employeeId || "-" %>
                        </span>

                      </td>

                      <td class="px-6 py-4">

                        <div class="flex items-center gap-2">

                          <div
                            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand"
                          >
                            <i class="fa-solid fa-building"></i>
                          </div>

                          <span class="max-w-[180px] truncate text-sm font-medium text-text">
                            <%= member.department || "-" %>
                          </span>

                        </div>

                      </td>

                      <td class="px-6 py-4">

                        <% if (Array.isArray(member.skills) && member.skills.length > 0) { %>

                          <div class="flex max-w-[220px] flex-wrap gap-1.5">

                            <% member.skills.slice(0, 2).forEach((skill) => { %>

                              <span
                                class="max-w-[100px] truncate rounded-full bg-page-background px-2.5 py-1 text-xs font-medium text-text-muted"
                                title="<%= skill %>"
                              >
                                <%= skill %>
                              </span>

                            <% }); %>

                            <% if (member.skills.length > 2) { %>

                              <span
                                class="rounded-full bg-brand/10 px-2.5 py-1 text-xs font-semibold text-brand"
                              >
                                +<%= member.skills.length - 2 %>
                              </span>

                            <% } %>

                          </div>

                        <% } else { %>

                          <span class="text-sm text-text-light">
                            No skills
                          </span>

                        <% } %>

                      </td>

                      <td class="px-6 py-4">

                        <% if (member.isActive === true) { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-success-light px-3 py-1.5 text-xs font-semibold text-success"
                          >
                            <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                            Active
                          </span>

                        <% } else { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-danger-light px-3 py-1.5 text-xs font-semibold text-danger"
                          >
                            <span class="h-1.5 w-1.5 rounded-full bg-danger"></span>
                            Inactive
                          </span>

                        <% } %>

                      </td>

                      <td class="px-6 py-4 text-center">

                        <span class="font-semibold text-accent">
                          <%= member.assignedRequests || 0 %>
                        </span>

                      </td>

                      <td class="px-6 py-4 text-center">

                        <span class="font-semibold text-accent">
                          <%= member.inProgressRequests || 0 %>
                        </span>

                      </td>


                      <td class="px-6 py-4 text-center">

                        <span class="font-semibold text-accent">
                          <%= member.completedRequests || 0 %>
                        </span>

                      </td>

                      <td class="px-6 py-4 text-center">

                        <span class="font-semibold text-accent">
                          <%= member.totalRequests || 0 %>
                        </span>

                      </td>

                      <td class="px-6 py-4">

                        <% if (member.isOnline === true) { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-brand-indigo"
                          >
                            <span
                              class="h-1.5 w-1.5 animate-pulse rounded-full bg-brand-indigo"
                            ></span>
                            Online
                          </span>

                        <% } else { %>

                          <span
                            class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600"
                          >
                            <span
                              class="h-1.5 w-1.5 rounded-full bg-slate-400"
                            ></span>
                            Offline
                          </span>

                        <% } %>

                      </td>

                      <td class="px-6 py-4 text-right">

                        <div class="flex items-center justify-end gap-1">

                         
                         <button type="button" 
                         data-staff-id="<%= member._id %>"
                         title="View Staff"
                         class="view-staff-btn cursor-pointer inline-flex h-9 w-9 items-center justify-center rounded-lg text-text-muted transition hover:bg-brand/10 hover:text-brand">
                            <i class="fa-solid fa-eye"></i>
                         </button>
                          
                          <a
                            href="/admin/staff/<%= member._id %>/edit"
                            title="Edit Staff"
                            aria-label="Edit Staff"
                            class="cursor-pointer inline-flex h-9 w-9 items-center justify-center rounded-lg text-text-muted transition hover:bg-brand/10 hover:text-brand"
                          >
                            <i class="fa-solid fa-pen"></i>
                          </a>


                          <button
                            type="button"
                            onclick="EditStaffStatus('<%= member._id %>')"
                            class="cursor-pointer inline-flex h-9 w-9 items-center justify-center rounded-lg text-text-muted transition hover:bg-danger-light hover:text-danger"
                          >
                              <% if (member.isActive) { %>

                                  <i class="fa-solid fa-toggle-on text-success"></i>

                              <% } else { %>

                                  <i class="fa-solid fa-toggle-off text-text-muted"></i>

                              <% } %>
                          </button>

                        </div>

                      </td>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>

            

            <%- include('../../partials/pagination', {
              pagination: pagination,
              query: query,
              baseUrl: baseUrl
            }) %>

          <% } %>

        </div>

      </div>
    
    </section>

  </main>
       <%- include("viewStaff") %>


</div>


<script src="/js/viewStaff.js"></script>
<script>

async function EditStaffStatus(staffId) {


  try {
    const response = await fetch(
      `/admin/staff/${staffId}/status`,
      {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        credentials: "include",
      }
    );

    const result = await response.json();

   

    if (window.toast) {
      window.toast.success(
        result.message ||
          "Staff deactivated successfully."
      );
    }

    setTimeout(() => {
      window.location.reload();
    }, 1000);

  } catch (error) {
    console.log("Delete staff error:",error);

    if (window.toast) {
      window.toast.error(
        "Something went wrong. Please try again."
      );
    }
  }
}

</script>
<script src="/js/adminNotification.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/adminSocket.js"></script>

<script src="/js/adminNotificationPage.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    AdminNotification.getUnreadCount();
  });
</script>

</body>
</html>