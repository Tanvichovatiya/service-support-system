
<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Add Staff</title>

  <link rel="stylesheet" href="/css/output.css" />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
    integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <%- include('../../partials/toast') %>
   <script src="/socket.io/socket.io.js"></script>
    <script src="/js/adminSocket.js"></script>
</head>


<body
  class=" bg-background font-admin text-text-primary antialiased"
>

  <div class="flex h-screen flex-col overflow-hidden md:flex-row">

     <%- include('../../partials/sidebar') %>

    <main class="flex min-w-0 flex-1 flex-col overflow-hidden">

      <header class="shrink-0 border-b border-border bg-surface shadow-admin">

        <div class="mx-auto w-full max-w-5xl px-4 py-5 sm:px-6">

          <div class="flex items-center gap-3 sm:gap-4">

            <a href="#"
              onclick="history.back(); return false;"
              aria-label="Back to staff"
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-admin border border-border text-text-secondary transition hover:border-brand hover:bg-brand-soft hover:text-brand">
              <i class="fa-solid fa-arrow-left"></i>
            </a>

            <div class="min-w-0">

              <p class="text-sm font-semibold text-brand">
                Staff Management
              </p>

              <h1
                class="mt-1 truncate text-xl font-bold text-heading sm:text-2xl"
              >
                Add Staff Member
              </h1>

            </div>

          </div>

        </div>

      </header>

      <section class="flex-1 overflow-y-auto overflow-x-hidden px-4 py-6 sm:px-6 sm:py-8">

        <div class="mx-auto w-full max-w-5xl">


          <form action="/admin/staff/add" method="POST" class="overflow-y-auto rounded-admin-xl border border-border bg-surface shadow-admin">


            <div class="border-b border-border p-5 sm:p-8">

              <div class="mb-6">

                <div class="mb-2 flex items-center gap-3">

                  <div
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-admin bg-brand-soft text-brand"
                  >
                    <i class="fa-solid fa-user"></i>
                  </div>

                  <h2 class="text-lg font-bold text-heading">
                    Personal Information
                  </h2>

                </div>

                <p class="text-sm leading-6 text-text-secondary">
                  Enter the staff member's basic personal information.
                </p>

              </div>


              <div class="grid grid-cols-1 gap-5 sm:gap-6 md:grid-cols-2">


                <!-- FIRST NAME -->
                <div>

                  <label
                    for="firstname"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    First Name
                    <span class="text-danger">*</span>
                  </label>

                  <input
                    type="text"
                    id="firstname"
                    name="firstname"
                    value="<%= formData?.firstname || '' %>"
                    placeholder="Enter first name"
                    autocomplete="given-name"
                    class="w-full rounded-admin border border-input-border bg-input-background px-4 py-3 text-sm text-text-primary outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                  />

                  <% if (errors?.firstname) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.firstname.msg %>
                    </p>
                  <% } %>

                </div>


                <!-- LAST NAME -->
                <div>

                  <label
                    for="lastname"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    Last Name
                    <span class="text-danger">*</span>
                  </label>

                  <input
                    type="text"
                    id="lastname"
                    name="lastname"
                    value="<%= formData?.lastname || '' %>"
                    placeholder="Enter last name"
                    autocomplete="family-name"
                    class="w-full rounded-admin border border-input-border bg-input-background px-4 py-3 text-sm text-text-primary outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                  />

                  <% if (errors?.lastname) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.lastname.msg %>
                    </p>
                  <% } %>

                </div>


                <!-- EMAIL -->
                <div>

                  <label
                    for="email"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    Email Address
                    <span class="text-danger">*</span>
                  </label>

                  <div class="relative">

                    <i
                      class="fa-regular fa-envelope pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-input-placeholder"
                    ></i>

                    <input
                      type="email"
                      id="email"
                      name="email"
                      value="<%= formData?.email || '' %>"
                      placeholder="staff@example.com"
                      autocomplete="email"
                      class="w-full rounded-admin border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-text-primary outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                    />

                  </div>

                  <% if (errors?.email) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.email.msg %>
                    </p>
                  <% } %>

                </div>


                <!-- GENDER -->
                <div>

                  <label
                    for="gender"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    Gender
                    <span class="text-danger">*</span>
                  </label>

                  <select
                    id="gender"
                    name="gender"
                    class="w-full rounded-admin border border-input-border bg-input-background px-4 py-3 text-sm text-text-primary outline-none transition focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                  >

                    <option value="">
                      Select gender
                    </option>

                    <option
                      value="Male"
                      <%= formData?.gender === 'Male' ? 'selected' : '' %>
                    >
                      Male
                    </option>

                    <option
                      value="Female"
                      <%= formData?.gender === 'Female' ? 'selected' : '' %>
                    >
                      Female
                    </option>

                  </select>

                  <% if (errors?.gender) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.gender.msg %>
                    </p>
                  <% } %>

                </div>

              </div>

            </div>


            <div class="border-b border-border p-5 sm:p-8">

              <div class="mb-6">

                <div class="mb-2 flex items-center gap-3">

                  <div
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-admin bg-brand-soft text-brand"
                  >
                    <i class="fa-solid fa-briefcase"></i>
                  </div>

                  <h2 class="text-lg font-bold text-heading">
                    Employment Information
                  </h2>

                </div>

                <p class="text-sm leading-6 text-text-secondary">
                  Configure the staff member's employee details.
                </p>

              </div>


              <div class="grid grid-cols-1 gap-5 sm:gap-6 md:grid-cols-2">


                <!-- EMPLOYEE ID -->
                <div>

                  <label
                    for="employeeId"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    Employee ID
                    <span class="text-danger">*</span>
                  </label>

                  <div class="relative">

                    <i
                      class="fa-solid fa-id-card pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-input-placeholder"
                    ></i>

                    <input
                      type="text"
                      id="employeeId"
                      name="employeeId"
                      value="<%= formData?.employeeId || '' %>"
                      placeholder="EMP001"
                      class="w-full rounded-admin border border-input-border bg-input-background py-3 pl-11 pr-4 text-sm text-text-primary outline-none transition placeholder:text-input-placeholder focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                    />

                  </div>

                  <% if (errors?.employeeId) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.employeeId.msg %>
                    </p>
                  <% } %>

                </div>


                <!-- DEPARTMENT -->
                <div>

                  <label
                    for="department"
                    class="mb-2 block text-sm font-semibold text-heading"
                  >
                    Department
                    <span class="text-danger">*</span>
                  </label>

                  <select
                    id="department"
                    name="department"
                    class="w-full rounded-admin border border-input-border bg-input-background px-4 py-3 text-sm text-text-primary outline-none transition focus:border-input-focus focus:ring-4 focus:ring-brand/10"
                  >

                    <option value="">
                      Select department
                    </option>

                    <option
                      value="Technical Support"
                      <%= formData?.department === 'Technical Support' ? 'selected' : '' %>
                    >
                      Technical Support
                    </option>

                    <option
                      value="Customer Support"
                      <%= formData?.department === 'Customer Support' ? 'selected' : '' %>
                    >
                      Customer Support
                    </option>

                    <option
                      value="Billing"
                      <%= formData?.department === 'Billing' ? 'selected' : '' %>
                    >
                      Billing
                    </option>

                    <option
                      value="Operations"
                      <%= formData?.department === 'Operations' ? 'selected' : '' %>
                    >
                      Operations
                    </option>

                  </select>

                  <% if (errors?.department) { %>
                    <p class="mt-1.5 text-sm text-danger">
                      <%= errors.department.msg %>
                    </p>
                  <% } %>

                </div>

              </div>

            </div>


            <div class="border-b border-border p-5 sm:p-8">

              <div class="mb-6">

               <div class="mb-2 flex items-center gap-3">

                 <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-admin bg-brand-soft text-brand">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                 </div>

                 <h2 class="text-lg font-bold text-heading">
                   Skills
                 </h2>
               </div>

            <p class="text-sm leading-6 text-text-secondary">
                Select skills that can help with service request assignment.
            </p>
         </div>
<div class="flex flex-wrap gap-3">

  <label class="skill-option cursor-pointer select-none">
    <input
      type="checkbox"
      name="skills"
      value="Technical Support"
      class="skill-checkbox hidden"
      <%= formData?.skills?.includes("Technical Support") ? "checked" : "" %>
    />

    <span
      class="skill-badge inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2.5 text-sm font-medium text-text-secondary transition-all duration-200 hover:border-brand hover:bg-brand-soft hover:text-brand"
    >
      <i class="fa-solid fa-headset text-xs"></i>
      <span>Technical Support</span>
    </span>
  </label>


  <label class="skill-option cursor-pointer select-none">
    <input
      type="checkbox"
      name="skills"
      value="Networking"
      class="skill-checkbox hidden"
      <%= formData?.skills?.includes("Networking") ? "checked" : "" %>
    />

    <span
      class="skill-badge inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2.5 text-sm font-medium text-text-secondary transition-all duration-200 hover:border-brand hover:bg-brand-soft hover:text-brand"
    >
      <i class="fa-solid fa-network-wired text-xs"></i>
      <span>Networking</span>
    </span>
  </label>

  <label class="skill-option cursor-pointer select-none">
    <input
      type="checkbox"
      name="skills"
      value="Hardware"
      class="skill-checkbox hidden"
      <%= formData?.skills?.includes("Hardware") ? "checked" : "" %>
    />

    <span
      class="skill-badge inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2.5 text-sm font-medium text-text-secondary transition-all duration-200 hover:border-brand hover:bg-brand-soft hover:text-brand"
    >
      <i class="fa-solid fa-microchip text-xs"></i>
      <span>Hardware</span>
    </span>
  </label>

  <label class="skill-option cursor-pointer select-none">
    <input
      type="checkbox"
      name="skills"
      value="Software"
      class="skill-checkbox hidden"
      <%= formData?.skills?.includes("Software") ? "checked" : "" %>
    />

    <span
      class="skill-badge inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2.5 text-sm font-medium text-text-secondary transition-all duration-200 hover:border-brand hover:bg-brand-soft hover:text-brand"
    >
      <i class="fa-solid fa-code text-xs"></i>
      <span>Software</span>
    </span>
  </label>

</div>


  <% if (errors?.skills) { %>

    <p class="mt-3 text-sm text-danger">
      <%= errors.skills.msg %>
    </p>

  <% } %>

            </div>

            <div class="border-b border-border bg-brand-soft p-5 sm:p-8">

              <div class="flex items-start gap-4">

                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand text-white shadow-admin-sm"
                >
                  <i class="fa-solid fa-envelope"></i>
                </div>


                <div class="min-w-0">

                  <h3 class="font-semibold text-heading">
                    Staff Invitation
                  </h3>

                  <p class="mt-1 text-sm leading-6 text-text-secondary">
                    After creating the account, the staff member will
                    receive an email containing a secure link to create
                    their password. The setup link will expire after
                    30 minutes.
                  </p>

                </div>

              </div>

            </div>



            <div class="flex flex-col-reverse gap-3 bg-surface px-5 py-5 sm:flex-row sm:justify-end sm:px-8">
              <a
                href="/admin/staff/addStaff"
                class="inline-flex min-h-11 items-center justify-center rounded-admin border border-border px-5 py-2.5 text-sm font-semibold text-text-secondary transition hover:border-border-dark hover:bg-background-soft hover:text-heading"
              >
                Cancel
              </a>

              <button
                type="submit"
                class="inline-flex min-h-11 items-center justify-center gap-2 rounded-admin bg-brand px-6 py-2.5 text-sm font-semibold text-white shadow-admin-sm transition hover:bg-brand-dark hover:shadow-admin-md focus:outline-none focus:ring-4 focus:ring-brand/15"
              >
                <i class="fa-solid fa-user-plus"></i>

                <span>
                  Create Staff
                </span>
              </button>

            </div>


          </form>

        </div>

      </section>

    </main>

  </div>
  <script src="/js/addstaff.js"></script>
</body>

</html>
