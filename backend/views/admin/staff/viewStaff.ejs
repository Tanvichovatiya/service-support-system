

<div
  id="viewStaffModal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  aria-labelledby="viewStaffTitle"
  aria-modal="true"
  role="dialog"
>
 
  <div id="viewStaffBackdrop" class="fixed inset-0 bg-black/50 backdrop-blur-sm "></div>

  <div class="relative flex min-h-full items-center justify-center p-4 sm:p-6 ">

    <div id="viewStaffDialog"
      class="relative mx-auto w-full max-w-4xl overflow-hidden rounded-2xl border-2 border-accent  bg-white shadow-2xl">

    

      <div class="flex items-center justify-between border-b border-accent bg-accent   px-5 py-4 sm:px-6">

        <div class="">
          <h2
            id="viewStaffTitle"
            class="text-lg font-semibold text-gray-900 sm:text-xl">
            Staff Details
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            View staff information and recent requests
          </p>
        </div>

        <button
          type="button"
          id="closeViewStaff"  
          class="cursor-pointer inline-flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-100 hover:text-gray-900">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>

      </div>



      <div id="viewStaffLoading" class="flex min-h-[350px] items-center justify-center p-8">
        <div class="text-center">
          <div class="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-gray-200 border-t-brand"></div>
          <p class="mt-4 text-sm text-gray-500">
            Loading staff details...
          </p>
        </div>
      </div>



      <div id="viewStaffError" class="hidden min-h-[350px] items-center justify-center p-8">
        
        <div class="text-center">

          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-50 text-red-500">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>

          <h3 class="mt-4 font-semibold text-gray-900">
            Unable to load staff
          </h3>

          <p id="viewStaffErrorMessage" class="mt-1 text-sm text-gray-500">
            Something went wrong.
          </p>

          <button
            type="button"
            id="retryViewStaff"
            class="mt-5 rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition hover:opacity-90 cursor-pointer"
          >
            Try Again
          </button>

        </div>
      </div>


     

      <div id="viewStaffContent" class="hidden max-h-[75vh] overflow-y-auto">

        <div class=" p-5 sm:p-6">

          <div class="flex flex-col gap-5 sm:flex-row sm:items-center">

            <div id="staffAvatar" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-xl font-bold text-brand"></div>
            
            <div class="min-w-0 flex-1">

              <div class="flex flex-wrap items-center gap-2">

                <h3 id="staffName" class="text-xl font-bold text-gray-900"></h3>

                <span id="staffActiveBadge" class="rounded-full px-2.5 py-1 text-xs font-semibold">
                </span>

                <span id="staffOnlineBadge" class="rounded-full px-2.5 py-1 text-xs font-semibold">
                </span>

              </div>


              <p id="staffEmployeeId" class="mt-1 text-sm text-gray-500"></p>

            </div>

          </div>

        </div>


        <div class="p-5 sm:p-6">

          <h4
            class="mb-4 text-sm font-semibold uppercase tracking-wide text-gray-500"
          >
            Staff Information
          </h4>


          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

         
            <div class="rounded-xl border-[1.4px] border-accent shadow-admin p-4">

              <p class="text-xs font-medium text-gray-500">
                Email
              </p>

              <p
                id="staffEmail"
                class="mt-1 break-all text-sm font-medium text-gray-900"
              >
              
              </p>

            </div>


            <div class="rounded-xl  border-[1.4px] border-accent shadow-admin p-4">

              <p class="text-xs font-medium text-gray-500">
                Gender
              </p>

              <p
                id="staffGender"
                class="mt-1 text-sm font-medium text-gray-900"
              >
               
              </p>

            </div>

            <div class="rounded-xl border-[1.4px] border-accent shadow-admin  p-4">

              <p class="text-xs font-medium text-gray-500">
                Department
              </p>

              <p
                id="staffDepartment"
                class="mt-1 text-sm font-medium text-gray-900"
              >
                
              </p>

            </div>


          
            <div class="rounded-xl border-[1.4px] border-accent shadow-admin p-4">

              <p class="text-xs font-medium text-gray-500">
                Joined
              </p>

              <p
                id="staffCreatedAt"
                class="mt-1 text-sm font-medium text-gray-900"
              >
                
              </p>

            </div>


            <div class="rounded-xl border-[1.4px] border-accent shadow-admin p-4">

              <p class="text-xs font-medium text-gray-500">
                Availability
              </p>

              <p
                id="staffAvailability"
                class="mt-1 text-sm font-medium text-gray-900"
              >
              
              </p>

            </div>

          </div>


         

          <div class="mt-6">

            <h4
              class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500"
            >
              Skills
            </h4>

            <div
              id="staffSkills"
              class="flex flex-wrap gap-2"
            >
              <span class="text-sm text-gray-400">
                No skills available
              </span>
            </div>

          </div>


          <div class="mt-8">

            <div class="mb-4 flex items-center justify-between gap-3">

              <div>
                <h4 class="text-base font-semibold text-gray-900">
                  Recent Requests
                </h4>

                <p class="mt-1 text-sm text-gray-500">
                  Latest service requests assigned to this staff
                </p>
              </div>

            </div>

            <div
              id="recentRequests"
              class="space-y-3"
            >
              
            </div>

          </div>

        </div>

      </div>


      <div
        class="flex justify-end   px-5 py-4 sm:px-6"
      >

        <button
          type="button"
          id="closeViewStaffFooter"
          class="cursor-pointer rounded-lg border-2 border-accent bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100"
        >
          Close
        </button>

      </div>

    </div>

  </div>

</div>
