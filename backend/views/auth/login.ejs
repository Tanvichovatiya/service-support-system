
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Login</title>

  <link rel="stylesheet" href="/css/output.css">
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  >
</head>

<body class="min-h-screen bg-gradient-to-br from-accent-light via-brand-soft to-accent-dark font-admin text-text-primary">

  <main class="flex min-h-screen items-center justify-center px-4 py-10">

    <div class="w-full max-w-md">

      <div class="mb-7 text-center">
        <div
          class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-admin-lg bg-brand shadow-admin-sm"
        >
          <i class="fa-solid fa-shield-halved text-xl text-white"></i>
        </div>

        <h1 class="text-2xl font-bold tracking-tight text-heading">
          Admin Panel
        </h1>

        <p class="mt-1 text-sm text-text-secondary">
          Sign in to manage your service platform
        </p>
      </div>

      <div
        class="rounded-admin-xl border border-border bg-login-card p-6 backdrop-blur-xl sm:p-8 shadow-admin-md"
      >

        <div class="mb-7">
          <h2 class="text-xl font-bold text-heading">
            Welcome back
          </h2>

          <p class="mt-1 text-sm text-text-secondary">
            Enter your credentials to continue.
          </p>
        </div>

        <% if (error) { %>
         
            <p class="text-sm text-center mb-2 font-medium text-danger">
              <%= error %>
            </p>

        <% } %>

        <form action="/admin/login" method="POST" class="space-y-5">

          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-semibold text-text-primary"
            >
              Email address
            </label>

            <div class="relative">
              <i
                class="fa-regular fa-envelope pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-text-muted"
              ></i>

              <input
                type="email"
                id="email"
                name="email"
                value="<%= formData?.email || '' %>"
                placeholder="admin@example.com"
                autocomplete="email"
                required
                class="w-full rounded-admin-lg border border-input-border bg-input-background py-3.5 pl-11 pr-4 text-sm text-text-primary outline-none transition duration-200 placeholder:text-input-placeholder hover:border-border-dark focus:border-input-focus focus:ring-4 focus:ring-input-focus/10"
              >
              <% if (errors?.email) { %> <p class="mt-1.5 text-xs font-medium text-danger"> <%= errors.email.msg %> </p> <% } %>
            </div>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between">
              <label
                for="password"
                class="text-sm font-semibold text-text-primary"
              >
                Password
              </label>

              <!-- <a
                href="/forgot-password"
                class="text-xs font-semibold text-brand transition-colors hover:text-brand-dark"
              >
                Forgot password?
              </a> -->
            </div>

            <div class="relative">
              <i
                class="fa-solid fa-lock pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-text-muted"
              ></i>

              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                
                class="<%= errors?.password ? 'border-danger focus:border-danger focus:ring-danger/10' : 'border-input-border focus:border-input-focus focus:ring-input-focus/10' %> w-full rounded-admin-lg border bg-input-background py-3.5 pl-11 pr-12 text-sm text-text-primary outline-none transition duration-200 placeholder:text-input-placeholder hover:border-border-dark focus:ring-4"
              >

              <button
                type="button"
                id="togglePassword"
                aria-label="Show password"
                class="cursor-pointer absolute right-0 top-0 flex h-full w-11 items-center justify-center text-text-muted transition-colors hover:text-brand focus:outline-none"
              >
                <i id="eyeIcon" class="fa-regular fa-eye"></i>
              </button>
              <% if (errors?.password) { %> <p class="mt-1.5 text-xs font-medium text-danger"> <%= errors.password.msg %> </p> <% } %>
            </div>
          </div>

         
          <button
            type="submit"
            class="cursor-pointer group flex w-full items-center justify-center gap-2 rounded-admin-lg bg-brand px-4 py-3.5 text-sm font-bold text-white shadow-admin-sm transition duration-200 hover:bg-brand-dark hover:shadow-admin-md active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-brand/20"
          >
            <span>Sign in</span>

            <i
              class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-0.5"
            ></i>
          </button>

        </form>


      </div>

    </div>

  </main>

  <script>
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");
    const eyeIcon = document.getElementById("eyeIcon");

    togglePassword.addEventListener("click", () => {
      const showPassword = passwordInput.type === "password";

      passwordInput.type = showPassword ? "text" : "password";

      eyeIcon.classList.toggle("fa-eye", !showPassword);
      eyeIcon.classList.toggle("fa-eye-slash", showPassword);

      togglePassword.setAttribute(
        "aria-label",
        showPassword ? "Hide password" : "Show password"
      );
    });

    window.addEventListener("DOMContentLoaded", () => {
      if (window.location.search.includes("error=")) {
        window.history.replaceState(
          {},
          document.title,
          window.location.pathname
        );
      }
    });
  </script>

</body>
</html>
